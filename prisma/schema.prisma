generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// MS-01 scope only: accounts + society + circuit subset of
// docs/engineering/09-architecture.md §5.2, enough to migrate cleanly and
// prove the walking skeleton (docs/backlog.yaml milestones: MS-01). The rest
// of the ~40-model schema is filled in milestone by milestone as each one's
// features need it — §5.2 itself says its field lists are "representative,
// not exhaustive."

/// Which part of FirsThing an internal account belongs to.
///
/// These are the blueprint's own personas (02-users-research.md §1), not a new
/// vocabulary: operations = PER-01, sales = PER-07, support = PER-02,
/// engineering = PER-04 (installer/commissioning), inspection = PER-03 (field
/// inspector), finance = PER-08.
///
/// The team decides what work an account may be ASSIGNED and whose behalf it
/// may act on. It is not a replacement for AdminPermission, which stays the
/// authority gate — a sales account with manage_pipeline can own a lead; the
/// team is what makes it eligible to be handed one in the first place.
enum AdminTeam {
  operations
  sales
  support
  engineering
  inspection
  finance
}

enum AdminPermission {
  manage_admins
  manage_users
  manage_pipeline // CAP-15 — sales lead/proposal actions (FEAT-001/002), PER-07
  manage_survey // CAP-16 — field survey actions (FEAT-006/007), PER-04. PER-01
  // (ops) typically holds both; kept separate since a real
  // deployment has different staff for sales vs. field work.

  // CAP-04 / CON-33 / FEAT-054-AC-4 — the accountant's release gate, PER-08.
  // Deliberately NOT conferred by the ops proxy (manage_pipeline +
  // manage_survey): the gate exists to put a second pair of eyes between the
  // calculation and the society, and an account that can run the month must
  // not be able to release it on its own say-so. ASSUM-21 was validated by
  // the user at the Phase 3 gate — a separate accountant with real hold
  // authority — so this is a real separation, not ceremony.
  release_billing

  @@map("admin_permission")
}

// office-bearer | committee | manager — FEAT-108, CON-45. A society account
// holds one of these; binding acts (accepting an offer, GATE-04) require
// office-bearer specifically, enforced server-side, never by this field alone.
enum PortalAuthority {
  office_bearer
  committee
  manager

  @@map("portal_authority")
}

/// What a portal member may SEE and DO, module by module (the customer-portal
/// revamp, 2026-08-29). A sidebar tab renders only with its grant, and every
/// page re-checks server-side — the same shape as AdminPermission, for the
/// same reason: a native enum array, not a join table, for a small static set.
///
/// Authority and grants answer different questions and deliberately do not
/// merge: PortalAuthority is WHO someone is to the society (GATE-04's binding
/// acts still require office_bearer specifically); a grant is which modules
/// they may use. An office-bearer implicitly holds every grant — computed in
/// src/lib/portal-access.ts, never stored, so a transfer cannot strand stale
/// rights on the old holder's row.
enum PortalGrant {
  electricity
  water_tanks
  documents
  inventory
  tickets_view
  /// Raise and update requests. Implies tickets_view (computed, not stored).
  tickets_manage
  /// See the members-and-access page. Editing access itself stays the
  /// office-bearer's act alone.
  society_admin

  @@map("portal_grant")
}

// docs/product/05a-theme-system.md §3.2b: the choice belongs to the account,
// not the browser or the OS — stored server-side, never inferred from
// prefers-color-scheme (the doc is explicit that the theme never changes by
// itself). Nullable on both account tables; null means "never chosen," which
// renders identically to explicitly choosing slate (§3.2b's own table).
enum Theme {
  light
  dark
  slate

  @@map("theme")
}

enum SocietyStatus {
  prospect
  active
  suspended
  terminated

  @@map("society_status")
}

// lighting | pumps | solar | wastewater — CON-24. A society engages one or
// more service lines independently; each holds its own pipeline/contract/
// circuits without touching another line's state.
enum ServiceLine {
  lighting
  pumps
  solar
  wastewater

  @@map("service_line")
}

// Provisional for MS-01 — only enough for the Circuit table to migrate and
// exist. "surveyed" through "actively billed" is 03-features.md FEAT-006's
// own stated span; the full lifecycle gets designed for real at MS-04
// (circuit registry & benchmark commissioning), not guessed here.
enum CircuitState {
  surveyed
  eligible
  ineligible // CON-16 hard-criterion failure (FEAT-007-AC-5) — no exception path
  meter_installed // FEAT-011 — load validated within CON-17's ±10% band (or PER-01-overridden)
  pre_install_monitoring // FEAT-012 — 5-consecutive-valid-day window running
  awaiting_installation // FEAT-012 complete, baseline computed — ready for FEAT-013's light replacement
  post_install_pending // FEAT-013 — replacement + gate-pass done, FEAT-014's window not yet started
  post_install_monitoring // FEAT-014 — 5-consecutive-valid-day window running
  benchmark_confirmed // FEAT-014 — result fell in CON-20's 60-80% band, benchmarkSavingsPct written
  benchmark_review // FEAT-014-AC-5 — result outside 60-80%, routed to FEAT-015 (not yet built)
  active_billing
  retired

  @@map("circuit_state")
}

// FEAT-012/014 — the commissioning-scoped daily monitoring mechanism.
// Deliberately smaller than MS-07's full CSV/vendor-API reading ingest
// (not built until that milestone): PER-04 records one reading per
// calendar day directly against the circuit being commissioned. A missing
// day is simply the absence of a row here — distinguished from an
// actively-flagged anomaly (FEAT-012-AC-5) by presence/status rather than
// a third enum value.
enum CommissioningWindowType {
  pre_install
  post_install

  @@map("commissioning_window_type")
}

enum CommissioningReadingStatus {
  valid
  anomaly

  @@map("commissioning_reading_status")
}

model CommissioningReading {
  id             String                     @id @default(cuid())
  circuitId      String                     @map("circuit_id")
  windowType     CommissioningWindowType    @map("window_type")
  date           DateTime                   @map("date") // calendar day, stored at midnight UTC
  consumptionKwh Float?                     @map("consumption_kwh")
  status         CommissioningReadingStatus
  anomalyNote    String?                    @map("anomaly_note")
  recordedById   String                     @map("recorded_by_id")
  createdAt      DateTime                   @default(now()) @map("created_at")

  circuit    Circuit   @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  recordedBy AdminUser @relation(fields: [recordedById], references: [id])

  @@unique([circuitId, windowType, date])
  @@index([circuitId, windowType])
  @@map("commissioning_readings")
}

// FEAT-011/CON-18 — one instance of the cross-cutting gate-pass component
// (09-architecture.md §5, ADR-006): an itemized equipment list signed,
// photographed, and backend-approved before PER-04 leaves site. `kind` is
// deliberately a real enum, not a free string, even with one value today —
// FEAT-013's installation gate-pass is a second instance of the same
// component, added when that feature needs it, not guessed at here.
enum GatePassKind {
  demo_install
  demo_install_completion // FEAT-013 — light-replacement sign-off, CON-18

  @@map("gate_pass_kind")
}

// ADR-006 — `submitted` is provisional-release eligible: a `submitted` pass
// older than 30 minutes is flipped to `provisional` by the gatepass-sweep
// job (never by a client-side timer, per ADR-006's own reasoning), letting
// PER-04 proceed without an indefinite wait on backend approval.
enum GatePassStatus {
  submitted
  provisional
  approved
  rejected

  @@map("gate_pass_status")
}

// ADR-003 — the one piece of new infrastructure this schema introduces: a
// Postgres-backed job queue, polled by a dedicated worker process
// (scripts/job-worker.ts), carrying every time-driven guarantee in the
// product. MS-04 is the first point it's load-bearing (the gate-pass
// timeout); later milestones reuse the same table for SLA escalation, the
// CON-13 suspension countdown, and notification retries — not rebuilt per
// feature.
enum JobType {
  gatepass_sweep
  tank_level_sample
  meter_poll

  @@map("job_type")
}

enum JobStatus {
  pending
  running
  done
  failed

  @@map("job_status")
}

model Job {
  id        String    @id @default(cuid())
  type      JobType
  runAt     DateTime  @map("run_at")
  status    JobStatus @default(pending)
  attempts  Int       @default(0)
  payload   Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("jobs")
}

model GatePass {
  id             String         @id @default(cuid())
  circuitId      String         @map("circuit_id")
  kind           GatePassKind
  status         GatePassStatus @default(submitted)
  itemsJson      Json           @map("items_json") // itemized equipment list, CON-18
  photoUrl       String?        @map("photo_url")
  submittedById  String         @map("submitted_by_id")
  submittedAt    DateTime       @default(now()) @map("submitted_at")
  approvedById   String?        @map("approved_by_id")
  approvedAt     DateTime?      @map("approved_at")
  rejectedReason String?        @map("rejected_reason")

  circuit     Circuit    @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  submittedBy AdminUser  @relation("GatePassSubmittedBy", fields: [submittedById], references: [id])
  approvedBy  AdminUser? @relation("GatePassApprovedBy", fields: [approvedById], references: [id])

  @@index([circuitId])
  @@index([status])
  @@map("gate_passes")
}

// FEAT-039 — an engagement's own independent status, separate from the
// pipeline/contract state that sits on top of it.
enum EngagementStatus {
  active
  inactive

  @@map("engagement_status")
}

// CAP-15 — CON-24's earliest pipeline stages. MS-03's own scope is lead
// through survey-pending/closed-lost; offer/agreement/installation/active
// stages get added when the milestones that build them (MS-05+) need them —
// same "fill in the enum as each milestone needs it" convention as
// CircuitState above.
enum PipelineStage {
  lead
  survey_pending
  // MS-05. Names follow 04-flows-system-map.md's Pipeline state table; only
  // the stages a built feature actually sets are added, same convention as
  // CircuitState's milestone-by-milestone growth.
  demo_reported
  offered
  agreed
  // MS-06
  installation // FEAT-033 — contract executed, installation project running
  active_billing // FEAT-037-AC-1 — completion certificate signed; billing starts the next day (CON-22)
  closed_lost

  @@map("pipeline_stage")
}

// FEAT-006-AC-6 — how an area's light count was obtained. "estimated" rows
// require a note and are surfaced as a review weakness (FEAT-010, not yet
// built) rather than looking identical to a walked count.
enum LightCountMethod {
  walked
  estimated

  @@map("light_count_method")
}

// ── Society & account (COMP-09) ──────────────────────────────────────────

model Society {
  id               String        @id @default(cuid())
  name             String
  /// Normalised "name|location" — the DB-level guarantee that a society is
  /// never entered twice (2026-08-26). An application check cannot win a
  /// race with itself; a unique index can. See src/lib/society-key.ts.
  dedupeKey        String        @unique @map("dedupe_key")
  /// Nullable: a society can be on the system before anyone has a
  /// trustworthy flat count (2026-08-26). Listing-site figures for the
  /// first import were demonstrably wrong, and this repo states a gap
  /// rather than fabricating a figure — the same rule as the Portfolio's
  /// "not yet tracked" tiles. Nothing computes money from it.
  flatCount        Int?          @map("flat_count")
  location         String
  latitude         Float?
  longitude        Float?
  status           SocietyStatus @default(prospect)
  nextElectionDate DateTime?     @map("next_election_date") // CON-28a — a prompt, never enforced
  createdAt        DateTime      @default(now()) @map("created_at")

  contacts        SocietyContact[]
  profiles        Profile[]
  circuits        Circuit[]
  pipelines       Pipeline[]
  scheduledEvents ScheduledEvent[]
  waterTanks      WaterTank[]
  meterDevices    MeterDevice[]
  contracts       Contract[]
  engagements     Engagement[]

  // MS-06
  fieldVisits          FieldVisit[]
  installationProjects InstallationProject[]

  // MS-08
  monthlyCalculations MonthlyCalculation[]
  storedDocuments     StoredDocument[]
  tickets             Ticket[]

  @@map("societies")
}

// FEAT-039 — the abstraction every pipeline/contract/billing record keys
// against; a society is never "a lighting customer," it's a society with
// one or more independent service-line engagements. Closes a gap
// societies/actions.ts already flagged (FEAT-085-AC-5 needed exactly this
// entity and didn't have it yet). SVC-03/04 (solar/wastewater) can be
// enrolled here but are deliberately inert — FEAT-039-AC-5 — nothing else
// in the product builds operational screens against them yet.
model Engagement {
  id          String           @id @default(cuid())
  societyId   String           @map("society_id")
  serviceLine ServiceLine      @map("service_line")
  status      EngagementStatus @default(active)
  createdAt   DateTime         @default(now()) @map("created_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([societyId, serviceLine])
  @@map("engagements")
}

model SocietyContact {
  id        String  @id @default(cuid())
  societyId String  @map("society_id")
  name      String
  post      String? // committee post, e.g. "Secretary"
  email     String?
  phone     String?
  active    Boolean @default(true) // never deleted — FEAT-092 AC-5

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId])
  @@map("society_contacts")
}

// Society-side portal login (office-bearer/committee/manager). Deliberately
// a separate table from AdminUser — see PROJECT_CONTEXT.md and INV-01: an
// admin session can only ever be minted from AdminUser, never from here.
model Profile {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String           @map("password_hash")
  name            String?
  portalAuthority PortalAuthority? @map("portal_authority")
  /// Module access (see PortalGrant). Empty means no module tabs — the
  /// migration backfills existing accounts with everything they could see
  /// before grants existed, so nobody lost access on deploy.
  grants          PortalGrant[]    @default([])
  societyId       String?          @map("society_id")
  isActive        Boolean          @default(true) @map("is_active")
  themePreference Theme?           @map("theme_preference")
  /// When this member last opened their notifications — the bell counts
  /// events newer than this. One timestamp, not a per-event read table:
  /// the feed is derived from rows of record, so there is no event row to
  /// key reads against, and "seen up to here" is what a bell means anyway.
  notificationsSeenAt DateTime?    @map("notifications_seen_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  society         Society? @relation(fields: [societyId], references: [id], onDelete: SetNull)
  offersResponded Offer[]  @relation("OfferRespondedBy")

  // MS-06 — being *named* onlooker is what confers the batch-approval right,
  // not holding office-bearer authority (that is GATE-04's separate rule).
  projectsWatched InstallationProject[]    @relation("ProjectOnlooker")
  daysWatched     InstallationPlannedDay[] @relation("PlannedDayOnlooker")
  batchesReviewed BatchReview[]            @relation("BatchReviewedBy")

  ticketsRaised  Ticket[] @relation("TicketRaisedBy")
  ticketsTouched Ticket[] @relation("TicketStatusBy")

  @@index([societyId])
  @@map("profiles")
}

// Deliberately a separate table from Profile, not a shared "role" column —
// see PROJECT_CONTEXT.md and 00-intake.md INV-01. An admin session can only
// ever be minted by a row existing here; a Profile row can never carry admin
// access, by construction rather than by a role check that could be bypassed.
model AdminUser {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String            @map("password_hash")
  name         String?
  isActive     Boolean           @default(true) @map("is_active")
  /// PER-01 by default: every pre-existing account was an ops account.
  team         AdminTeam         @default(operations)
  permissions  AdminPermission[]
  // DEMO_MODE's per-account switch. The env var is the master gate — with
  // it unset this column can never turn anything on, and no toggle renders.
  // Default false so a missing choice reads as normal mode.
  demoMode     Boolean           @default(false) @map("demo_mode")

  themePreference Theme?   @map("theme_preference")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  // Soft delete. An AdminUser is the recorded actor on dozens of tables
  // below — who approved a gate pass, who released a month, who voided a
  // baseline — so the row can never actually go away without taking that
  // provenance with it. Removal hides the account and stops it signing in;
  // the history keeps pointing at a real name.
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  createdBy AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created   AdminUser[] @relation("AdminCreatedBy")
  deletedBy AdminUser?  @relation("AdminDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deleted   AdminUser[] @relation("AdminDeletedBy")

  pipelinesOwned              Pipeline[]           @relation("PipelineSalesOwner")
  pipelinesSurveying          Pipeline[]           @relation("PipelineSurveyOwner")
  pipelinesSurveyAssigned     Pipeline[]           @relation("PipelineSurveyAssignedBy")
  scheduledEvents             ScheduledEvent[]     @relation("ScheduledEventAssignee")
  circuitsReplacing           Circuit[]            @relation("CircuitReplacementOwner")
  waterTanksAssigned          WaterTank[]          @relation("WaterTankAssignedBy")
  meterDevicesAssigned        MeterDevice[]        @relation("MeterDeviceAssignedBy")
  meterDevicesOwned           MeterDevice[]        @relation("MeterDeviceOwner")
  meterAlertsAcknowledged     MeterAlert[]         @relation("MeterAlertAcknowledgedBy")
  meterCsvImports             MeterCsvImport[]     @relation("MeterCsvImportUploadedBy")
  storedDocuments             StoredDocument[]     @relation("StoredDocumentUploadedBy")
  ticketsTouched              Ticket[]             @relation("TicketStatusByAdmin")
  storedDocumentsVoided       StoredDocument[]     @relation("StoredDocumentVoidedBy")
  documentExtractions         DocumentExtraction[] @relation("DocumentExtractionConfirmedBy")
  ewelinkConfigsUpdated       EwelinkApiConfig[]   @relation("EwelinkApiConfigUpdatedBy")
  tankApiConfigUpdated        TankApiConfig[]      @relation("TankApiConfigUpdatedBy")
  circuitsReplacementAssigned Circuit[]            @relation("CircuitReplacementAssignedBy")
  scheduledEventsCreated      ScheduledEvent[]     @relation("ScheduledEventCreatedBy")
  pipelinesLogged             Pipeline[]           @relation("PipelineLoggedBy")

  circuitLoadOverrides          Circuit[]               @relation("CircuitLoadOverrideBy")
  circuitsCreated               Circuit[]               @relation("CircuitCreatedBy")
  circuitsVoided                Circuit[]               @relation("CircuitVoidedBy")
  demoResultsResolved           DemoResultReview[]      @relation("DemoResultResolvedBy")
  gatePassSubmissions           GatePass[]              @relation("GatePassSubmittedBy")
  gatePassApprovals             GatePass[]              @relation("GatePassApprovedBy")
  commissioningReadingsRecorded CommissioningReading[]
  circuitDevicesReplaced        CircuitDevice[]         @relation("CircuitDeviceReplacedBy")
  circuitDevicesRecorded        CircuitDevice[]         @relation("CircuitDeviceRecordedBy")
  benchmarkRescalesRecorded     BenchmarkRescaleEvent[] @relation("BenchmarkRescaleRecordedBy")
  benchmarkRescalesVoided       BenchmarkRescaleEvent[] @relation("BenchmarkRescaleVoidedBy")

  // MS-05
  demoReportsShared  DemoReport[]      @relation("DemoReportSharedBy")
  kycMarkedNa        KycRequirement[]  @relation("KycMarkedNaBy")
  kycFilesUploaded   KycDocumentFile[] @relation("KycFileUploadedBy")
  kycFilesVerified   KycDocumentFile[] @relation("KycFileVerifiedBy")
  kycFollowUps       KycFollowUp[]     @relation("KycFollowUpBy")
  offersIssued       Offer[]           @relation("OfferIssuedBy")
  agreementsPrepared Agreement[]       @relation("AgreementPreparedBy")
  agreementsUploaded Agreement[]       @relation("AgreementUploadedBy")
  contractsActivated Contract[]        @relation("ContractActivatedBy")

  // MS-08
  calculationsReleased     MonthlyCalculation[]  @relation("CalculationReleasedBy")
  calculationsSentBack     MonthlyCalculation[]  @relation("CalculationSentBackBy")
  deviationsAssigned       DeviationReview[]     @relation("DeviationAssignedTo")
  deviationsOwned          DeviationReview[]     @relation("DeviationOwner")
  invoicesUploaded         BillingInvoice[]      @relation("InvoiceUploadedBy")
  invoicePaymentsConfirmed BillingInvoice[]      @relation("InvoicePaymentConfirmedBy")
  invoiceMismatchesAcked   BillingInvoice[]      @relation("InvoiceMismatchAckBy")
  paymentsRecorded         Payment[]             @relation("PaymentRecordedBy")
  extensionsGranted        InvoiceExtension[]    @relation("ExtensionGrantedBy")
  contractTermsRecorded    ContractTermVersion[] @relation("ContractTermRecordedBy")

  // MS-06
  fieldVisitsJoined    FieldVisitParticipant[]  @relation("FieldVisitParticipant")
  areaClaimsMade       FieldVisitAreaClaim[]    @relation("AreaClaimClaimedBy")
  areaClaimsResolved   FieldVisitAreaClaim[]    @relation("AreaClaimResolvedBy")
  projectsCreated      InstallationProject[]    @relation("InstallationProjectCreatedBy")
  gateSkipsApproved    InstallationProject[]    @relation("GateSkipApprovedBy")
  plannedDaysAssigned  InstallationPlannedDay[] @relation("PlannedDayAssignee")
  batchesSubmitted     InstallationBatch[]      @relation("BatchSubmittedBy")
  blockersRaised       InstallationBlocker[]    @relation("BlockerRaisedBy")
  blockersResolved     InstallationBlocker[]    @relation("BlockerResolvedBy")
  certificatesRecorded CompletionCertificate[]  @relation("CertificateRecordedBy")

  // MS-07
  rawReadingsUploaded RawReadingFile[]     @relation("RawReadingUploadedBy")
  anomaliesResolved   ReadingAnomaly[]     @relation("ReadingAnomalyResolvedBy")
  coverageAccepted    CoverageAcceptance[] @relation("CoverageAcceptedBy")
  deviceTypesDeleted  DeviceType[]         @relation("DeviceTypeDeletedBy")
  deviceTypesProposed DeviceType[]         @relation("DeviceTypeProposedBy")
  deviceTypesApproved DeviceType[]         @relation("DeviceTypeApprovedBy")

  @@map("admin_users")
}

// ── Deal & pipeline (COMP-01), MS-03 scope only ──────────────────────────
// CON-24: one Pipeline per (society, serviceLine) — the @@unique below is
// the structural guarantee, not just an application check. Field list is
// MS-03's own scope (FEAT-001/002) — offers/contracts/follow-ups arrive
// with the milestones that build them (09-architecture.md §5.2's "field
// lists are representative, not exhaustive").
model Pipeline {
  id          String        @id @default(cuid())
  societyId   String        @map("society_id")
  serviceLine ServiceLine   @map("service_line")
  stage       PipelineStage @default(lead)

  // FEAT-001 lead-capture fields
  contactName  String   @map("contact_name")
  contactPhone String?  @map("contact_phone")
  meetingDate  DateTime @map("meeting_date")
  notes        String?

  // FEAT-001-AC-1/2 — self-logged vs. entered-on-behalf-of. salesOwnerId is
  // who the lead belongs to; loggedById is who actually submitted it. Equal
  // => authoritative immediately. Different => pending-approval, and
  // salesOwner is notified (logged via logger.ts — see PROJECT_CONTEXT.md;
  // real notification delivery is NFR-10/R1, not built yet).
  salesOwnerId       String    @map("sales_owner_id")
  /// The field person the survey and demo commissioning are handed to.
  /// Null until someone assigns it — the work still belongs to the field
  /// team, it just has no name on it yet.
  surveyOwnerId      String?   @map("survey_owner_id")
  /// When the hand-over happened and who did it. The assignment left no trace
  /// of either, so "assigned to Inspector" could not be told apart from
  /// something the system had inferred (user-asked 2026-08-25).
  surveyAssignedAt   DateTime? @map("survey_assigned_at")
  surveyAssignedById String?   @map("survey_assigned_by_id")
  /// The visit itself is NOT stored here. Anything that happens at a time,
  /// with a person expected at it, is a ScheduledEvent — one module for every
  /// kind of appointment so they can all appear on one calendar (the user's
  /// call, 2026-08-25).
  loggedById         String    @map("logged_by_id")
  authoritative      Boolean   @default(true)

  // FEAT-002-AC-5 / FEAT-032 (not yet built) — demo-skip is recorded here
  // so the schema is ready for it; nothing in MS-03 sets these true yet.
  demoSkipped        Boolean   @default(false) @map("demo_skipped")
  demoSkipApprovedBy String?   @map("demo_skip_approved_by")
  demoSkipReason     String?   @map("demo_skip_reason")
  demoSkipDate       DateTime? @map("demo_skip_date")

  // FEAT-002 proposal fields
  proposalSummary   String?   @map("proposal_summary")
  proposalOutcome   String?   @map("proposal_outcome") // "agreed" | "declined" | "undecided"
  proposalDecidedAt DateTime? @map("proposal_decided_at")
  closedLostReason  String?   @map("closed_lost_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scheduledEvents ScheduledEvent[]

  society          Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  salesOwner       AdminUser   @relation("PipelineSalesOwner", fields: [salesOwnerId], references: [id])
  loggedBy         AdminUser   @relation("PipelineLoggedBy", fields: [loggedById], references: [id])
  surveyOwner      AdminUser?  @relation("PipelineSurveyOwner", fields: [surveyOwnerId], references: [id])
  surveyAssignedBy AdminUser?  @relation("PipelineSurveyAssignedBy", fields: [surveyAssignedById], references: [id])
  siteSurvey       SiteSurvey?

  // MS-05
  demoReports     DemoReport[]
  kycRequirements KycRequirement[]
  offers          Offer[]
  agreement       Agreement?
  contract        Contract?

  // MS-06
  installationProject InstallationProject?

  @@unique([societyId, serviceLine]) // CON-24
  @@index([salesOwnerId])
  @@map("pipelines")
}

// ── Site survey (CAP-16), MS-03 scope only (FEAT-006/007) ────────────────
// The umbrella record a field survey's captured data attaches to. CAP-16's
// full scope (governance profile, pump-room audit, logbook — FEAT-005/008/
// 009/010) is much larger and explicitly not built here; this table only
// carries what FEAT-006/007 need. One per Pipeline (a survey happens once
// per deal, matching CON-24 — re-surveys are a later, separate concern).
/// CAP — the schedule.
///
/// Everything in this product that happens AT A TIME with somebody expected
/// at it: the demo meeting with the committee, the survey visit, later the
/// installation days. One table rather than a scheduledAt column on each
/// owning record, because the question people actually ask is "what do I have
/// coming up" — which a per-feature column cannot answer without knowing
/// every feature (the user's call, 2026-08-25).
///
/// The event points BACK at what it is about; the owning record never stores
/// the time. Rescheduling, cancelling and "who is expected" therefore work
/// the same way for every kind, and a new kind is a new enum value plus a
/// caller, not a new mechanism.
model ScheduledEvent {
  id    String       @id @default(cuid())
  kind  ScheduleKind
  title String

  startAt DateTime  @map("start_at")
  /// Optional: most site work is booked as "10:30, allow a couple of hours"
  /// rather than to a hard finish.
  endAt   DateTime? @map("end_at")

  status          ScheduleStatus @default(scheduled)
  cancelledAt     DateTime?      @map("cancelled_at")
  cancelledReason String?        @map("cancelled_reason")

  /// The internal account expected to be there. Null means the team as a
  /// whole — an event nobody has been handed yet.
  assigneeId  String @map("assignee_id")
  createdById String @map("created_by_id")

  /// What it is about. A society is always known; the pipeline is set for
  /// anything on the deal spine, the circuit for commissioning work that
  /// happens on one metered circuit (the light replacement day).
  societyId  String  @map("society_id")
  pipelineId String? @map("pipeline_id")
  circuitId  String? @map("circuit_id")

  /// Who to ask for on arrival, and anything the visitor needs to know. This
  /// is the coordination that used to live in one person's phone.
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  note         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignee  AdminUser @relation("ScheduledEventAssignee", fields: [assigneeId], references: [id])
  createdBy AdminUser @relation("ScheduledEventCreatedBy", fields: [createdById], references: [id])
  society   Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  pipeline  Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  circuit   Circuit?  @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@index([assigneeId, startAt])
  @@index([startAt])
  @@map("scheduled_events")
}

enum ScheduleKind {
  demo_meeting
  survey_visit
  installation_day
  other
}

enum ScheduleStatus {
  scheduled
  done
  cancelled
}

model SiteSurvey {
  id         String   @id @default(cuid())
  pipelineId String   @unique @map("pipeline_id")
  createdAt  DateTime @default(now()) @map("created_at")

  pipeline Pipeline                @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  areas    LightingInventoryArea[]
  circuits Circuit[]

  @@map("site_surveys")
}

// FEAT-006 — whole-society count by area, distinct from the single sample
// Circuit metered for the benchmark (CON-11). FEAT-006-AC-5: a category the
// society doesn't have (no basement, say) is simply never rowed here, not
// recorded as zero.
model LightingInventoryArea {
  id           String           @id @default(cuid())
  siteSurveyId String           @map("site_survey_id")
  area         String // basement | stilt | lift-lobby | staircase | other — CON-11's category set
  lightType    String           @map("light_type")
  count        Int
  method       LightCountMethod @default(walked)
  note         String? // required in the app layer when method = estimated (FEAT-006-AC-6)
  createdAt    DateTime         @default(now()) @map("created_at")

  siteSurvey SiteSurvey @relation(fields: [siteSurveyId], references: [id], onDelete: Cascade)

  @@index([siteSurveyId])
  @@map("lighting_inventory_areas")
}

// ── Circuit & metering (COMP-02) — registry shape only, MS-01 ───────────
// Commissioning/benchmarking logic lands at MS-04; this milestone only needs
// the table to exist and migrate cleanly per its own exit criteria.

model Circuit {
  id                            String       @id @default(cuid())
  societyId                     String       @map("society_id")
  siteSurveyId                  String?      @map("site_survey_id") // FEAT-007 — which survey this candidate was selected during
  serviceLine                   ServiceLine  @map("service_line")
  location                      String? // FEAT-040 — physical area/location, set during registry configuration
  lightType                     String       @map("light_type") // basement | stilt | lift-lobby | staircase | external — CON-11
  meteredLightCount             Int          @map("metered_light_count")
  representedLightCount         Int          @map("represented_light_count") // scoped to this lightType only — CON-11
  wattage                       Float
  workingHours                  Float?       @map("working_hours") // metadata only, never triggers a rescale — CON-10
  // FEAT-040-AC-5 — when workingHours last changed; recorded so a later
  // off-band month can be traced to a metadata change vs. a real anomaly,
  // without that change itself ever triggering a benchmark rescale (CON-10).
  workingHoursEffectiveAt       DateTime?    @map("working_hours_effective_at")
  eligibilityChecklist          Json?        @map("eligibility_checklist") // CON-16 — per-criterion pass/fail, FEAT-007
  // FEAT-007-AC-3 — the one exception-able criterion (light count < 50);
  // every other hard criterion (fixtures >15ft, driveway) has no override.
  lightCountExceptionApprovedBy String?      @map("light_count_exception_approved_by")
  lightCountExceptionReason     String?      @map("light_count_exception_reason")
  // FEAT-011 — CON-17 load validation: the meter's displayed load vs.
  // (light count × wattage), and the resulting delta. A persistently
  // failed validation can only be overridden by PER-01 (FEAT-011-AC-5),
  // recorded here rather than silently accepted as a normal pass.
  meterDisplayedLoad            Float?       @map("meter_displayed_load")
  meterInstalledAt              DateTime?    @map("meter_installed_at")
  loadDiscrepancyPct            Float?       @map("load_discrepancy_pct")
  loadValidationOverrideById    String?      @map("load_validation_override_by_id")
  loadValidationOverrideReason  String?      @map("load_validation_override_reason")
  // FEAT-012/014 — pre/post monitoring windows. windowStartAt is the
  // calendar day valid-day counting begins from; an anomaly fix (AC-3)
  // bumps it forward to the midnight after the fix rather than mutating
  // past readings, so evaluation is always just "valid readings on/after
  // windowStartAt". Baselines are the resulting averages once each window
  // completes (FEAT-012-AC-1/FEAT-014-AC-1).
  preInstallWindowStartAt       DateTime?    @map("pre_install_window_start_at")
  preInstallBaseline            Float?       @map("pre_install_baseline")
  /// FEAT-013 — who is doing the replacement, and when it was handed to
  /// them. The visit itself is a ScheduledEvent (installation_day), not a
  /// column: an owning record never stores its own time.
  replacementOwnerId            String?      @map("replacement_owner_id")
  replacementAssignedAt         DateTime?    @map("replacement_assigned_at")
  replacementAssignedById       String?      @map("replacement_assigned_by_id")
  lightReplacementDate          DateTime?    @map("light_replacement_date") // FEAT-013 — the pivot day (last light replaced)
  postInstallWindowStartAt      DateTime?    @map("post_install_window_start_at")
  postInstallBaseline           Float?       @map("post_install_baseline")
  // FEAT-014 — the number the contract prices against (CON-20's 60-80%
  // band). System-computed only; FEAT-014-AC-4 requires no manual entry
  // path exists for it. FEAT-014 AC-8 (2026-08-27) adds ONE: a recorded
  // override, below — because the agreed figure a society is billed against
  // does not always equal what the readings give. Nothing else writes it.
  benchmarkSavingsPct           Float?       @map("benchmark_savings_pct")

  // The benchmark set by hand rather than derived from the demos. Aditya Mega
  // City's tables give 58.48%; its agreement says 64%. Rounding counts as an
  // override too, so a stored benchmark is always either measured or chosen.
  // An override never moves a circuit into CON-20's band — that is judged on
  // what the demos measured.
  benchmarkOverridePct          Float?       @map("benchmark_override_pct")
  benchmarkOverrideReason       String?      @map("benchmark_override_reason")
  benchmarkOverrideById         String?      @map("benchmark_override_by_id")
  benchmarkOverrideAt           DateTime?    @map("benchmark_override_at")
  state                         CircuitState @default(surveyed)
  createdAt                     DateTime     @default(now()) @map("created_at")
  // Who selected this candidate. Null for every circuit predating the column,
  // which `decideVoidCircuit` reads as "creator unknown" and falls through to
  // ops-only — the safe direction.
  createdById                   String?      @map("created_by_id")

  // Soft delete. A circuit is the grain CON-11 bills on, so it is never hard
  // deleted: the row survives, struck out, and stops being counted anywhere.
  // Authority rises with the lifecycle (see src/lib/circuit-void.ts) — the
  // creator may remove an untouched candidate, ops may remove one with
  // commissioning work, and nobody may remove one already billed on a
  // released invoice (GATE-02).
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  society                  Society                 @relation(fields: [societyId], references: [id], onDelete: Cascade)
  siteSurvey               SiteSurvey?             @relation(fields: [siteSurveyId], references: [id], onDelete: SetNull)
  loadValidationOverrideBy AdminUser?              @relation("CircuitLoadOverrideBy", fields: [loadValidationOverrideById], references: [id])
  createdBy                AdminUser?              @relation("CircuitCreatedBy", fields: [createdById], references: [id])
  voidedBy                 AdminUser?              @relation("CircuitVoidedBy", fields: [voidedById], references: [id])
  replacementOwner         AdminUser?              @relation("CircuitReplacementOwner", fields: [replacementOwnerId], references: [id])
  replacementAssignedBy    AdminUser?              @relation("CircuitReplacementAssignedBy", fields: [replacementAssignedById], references: [id])
  scheduledEvents          ScheduledEvent[]
  gatePasses               GatePass[]
  commissioningReadings    CommissioningReading[]
  rescaleEvents            BenchmarkRescaleEvent[]
  demoResultReviews        DemoResultReview[]
  demos                    CircuitDemo[]

  // MS-07
  rawReadingFiles     RawReadingFile[]
  meterReadings       MeterReading[]
  readingAnomalies    ReadingAnomaly[]
  coverageAcceptances CoverageAcceptance[]
  feeLines            CircuitFeeLine[]
  devices             CircuitDevice[]
  meterDevice         MeterDevice?
  alerts              MeterAlert[]

  @@index([societyId])
  @@index([siteSurveyId])
  @@map("circuits")
}

// FEAT-041 / INV-07 / CON-10 — a light-count-triggered baseline rescale is
// its own timestamped event type, deliberately NOT a mutation of
// Circuit.preInstallBaseline and deliberately NOT the same entity as a
// judgment-call billing adjustment (INV-03). The invariant exists so a
// dispute can always tell "the formula was reapplied" apart from "someone
// made a call" — conflating them in one table is precisely the failure
// mode it guards against.
//
// preInstallBaseline therefore stays exactly as commissioned, forever
// (ADR-005's versioned-not-mutated rule). The baseline in force at any
// date is derived by replaying these events — see src/lib/benchmark-
// rescale.ts, which is where the arithmetic lives and is unit-tested.
//
// FEAT-041-AC-5: effectiveDate is what forward-application keys off. A
// rescale dated into an already-invoiced month never restates that
// invoice; the difference goes through CAP-05's deviation review instead.
/// FEAT-014 AC-7 — a circuit can be demonstrated more than once.
///
/// Two reasons, and they lead to different benchmarks: a demo that ran badly
/// is REJECTED and the one done in its place decides alone, while a second
/// demo run at the society's own request counts alongside the first and the
/// benchmark becomes the mean of their savings percentages.
///
/// Each demo carries its own metered light count, because they are not
/// necessarily the same circuit twice — Aditya Urban Casa's were 100 lights
/// and 22. Its readings hang off the demo rather than the circuit, which is
/// also what lets two demos measured on overlapping dates coexist.
model CircuitDemo {
  id        String @id @default(cuid())
  circuitId String @map("circuit_id")
  /// 1, 2, 3 — the order they were run in, and how the screen orders them.
  sequence  Int

  meteredLightCount  Int    @map("metered_light_count")
  preInstallBaseline Float  @map("pre_install_baseline")
  postInstallAverage Float  @map("post_install_average")
  /// Verbatim, never rounded (AC-8).
  savingsPct         Float  @map("savings_pct")

  /// A rejected demo stays on record and takes no part in the figure.
  rejected        Boolean   @default(false)
  rejectionReason String?   @map("rejection_reason")
  decidedById     String?   @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at")

  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  circuit  Circuit             @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  readings CircuitDemoReading[]

  @@unique([circuitId, sequence])
  @@map("circuit_demos")
}

/// A demo's own daily readings, kept apart from `MeterReading`.
///
/// Deliberately not the billing table: these are the days that produced a
/// benchmark, not the days a month is billed on, and two demos on one circuit
/// routinely share dates — Aditya Urban Casa's overlap for four of them.
/// Putting them in `MeterReading` would either collide on its per-circuit
/// uniqueness or force that guarantee to be loosened for every circuit.
model CircuitDemoReading {
  id     String   @id @default(cuid())
  demoId String   @map("demo_id")
  date   DateTime @db.Date
  kWh    Float    @map("kwh")
  /// "pre" or "post" — which side of the replacement this day sits.
  phase  String

  demo CircuitDemo @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@unique([demoId, date, phase])
  @@map("circuit_demo_readings")
}

model BenchmarkRescaleEvent {
  id        String @id @default(cuid())
  circuitId String @map("circuit_id")

  previousLightCount Int   @map("previous_light_count")
  newLightCount      Int   @map("new_light_count")
  // Both baselines are stored, not just the result: INV-02 requires every
  // figure a society is billed on to be traceable to what produced it, and
  // recomputing "what was the baseline before this event" from the event
  // chain is exactly the kind of derivation that goes wrong under dispute.
  previousBaseline   Float @map("previous_baseline")
  rescaledBaseline   Float @map("rescaled_baseline")

  // FEAT-041-AC-3 — an unverified count change is refused outright, so
  // this is non-nullable by construction, not merely validated in the
  // action. verificationPhotoUrl stays optional for the same reason gate
  // passes' photo does: no file-storage infrastructure exists in this
  // src/ yet (see PROJECT_CONTEXT.md, MS-04).
  verificationNote     String  @map("verification_note")
  verificationPhotoUrl String? @map("verification_photo_url")

  effectiveDate DateTime @map("effective_date") // explicit user selection, never inferred (INV-04's spirit)
  recordedById  String   @map("recorded_by_id")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  // Soft delete, not edit-in-place, and not a hard delete.
  //
  // These rows replay into the baseline a society is billed on, so a mistyped
  // count silently corrupts every figure dated after it — an append-only log
  // with no correction path just accumulates that forever. But editing the
  // row would restate a figure someone was already billed on, and deleting it
  // would erase the fact that the wrong baseline was ever in force. Voiding
  // does neither: the entry stays visible with its owner and reason, and
  // stops counting toward the replay. A correction is a void plus a fresh
  // event, linked by `correctedByEventId`, in one transaction.
  voidedAt           DateTime? @map("voided_at")
  voidedById         String?   @map("voided_by_id")
  voidReason         String?   @map("void_reason")
  correctedByEventId String?   @unique @map("corrected_by_event_id")

  circuit     Circuit                @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  recordedBy  AdminUser              @relation("BenchmarkRescaleRecordedBy", fields: [recordedById], references: [id])
  voidedBy    AdminUser?             @relation("BenchmarkRescaleVoidedBy", fields: [voidedById], references: [id])
  correctedBy BenchmarkRescaleEvent? @relation("RescaleCorrection", fields: [correctedByEventId], references: [id])
  corrects    BenchmarkRescaleEvent? @relation("RescaleCorrection")

  @@index([circuitId, effectiveDate])
  @@map("benchmark_rescale_events")
}

// FEAT-015 — out-of-range demo result review.
//
// A post-install window that completes outside CON-20's 60-80% band does not
// write a benchmark (FEAT-014-AC-5). Before this existed the circuit parked in
// `benchmark_review` with nothing to act on, which quietly stranded the deal —
// the benchmark is what the contract prices against. R1 pulled forward,
// because R0 can reach the state today.

enum DemoResultReviewState {
  open
  resolved

  @@map("demo_result_review_state")
}

// The three outcomes FEAT-015's own description names. Deliberately an enum:
// AC-5's "repeat failure" and any later reporting on why demos fail both need
// this to be countable, not free text.
enum DemoResultResolution {
  rerun_window
  installation_defect
  escalate_manual_benchmark

  @@map("demo_result_resolution")
}

model DemoResultReview {
  id        String @id @default(cuid())
  circuitId String @map("circuit_id")

  // FEAT-015-AC-5 — 1 for a first failure, 2+ for one that recurred after a
  // restart. Stored rather than counted at read time so the queue can rank on
  // it without a correlated subquery per row.
  occurrence Int @default(1)

  // The figures that produced the out-of-range verdict, kept alongside the
  // review (INV-02) — recomputing them later from tables that have since moved
  // on is exactly the derivation that goes wrong under dispute.
  measuredSavingsPct Float @map("measured_savings_pct")
  preInstallBaseline Float @map("pre_install_baseline")
  postInstallAverage Float @map("post_install_average")

  state              DemoResultReviewState @default(open)
  resolution         DemoResultResolution?
  // FEAT-015-AC-1 — what was actually found on site.
  resolutionNote     String?               @map("resolution_note")
  // The description's "re-validates load (may re-trigger FEAT-011-style
  // checks)" — recorded when PER-01 actually did it, null when they didn't.
  loadRevalidatedPct Float?                @map("load_revalidated_pct")

  resolvedById String?   @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")
  raisedAt     DateTime  @default(now()) @map("raised_at")

  circuit    Circuit    @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  resolvedBy AdminUser? @relation("DemoResultResolvedBy", fields: [resolvedById], references: [id])

  @@index([state, raisedAt])
  @@index([circuitId])
  @@map("demo_result_reviews")
}

// ════════════════════════════════════════════════════════════════════════
// MS-05 — demo report, KYC, offer & agreement (FEAT-020/024/026/027/028/
// 029/062). Shapes follow 09-architecture.md §5.2's own Offer/Contract/
// Document sketches, extended only where an acceptance criterion needs a
// field the sketch didn't carry (each such extension is commented).
// ════════════════════════════════════════════════════════════════════════

// FEAT-020 — the demo savings report. Versioned rather than mutated: AC-5
// requires that a later benchmark rescale (INV-07) never rewrites an
// existing report, so a regeneration is a new version and the old one
// stands as the record of what was measured at the time. Same
// versioned-not-mutated rule as BenchmarkRescaleEvent (ADR-005).
enum DemoReportStatus {
  draft
  shared

  @@map("demo_report_status")
}

model DemoReport {
  id         String           @id @default(cuid())
  pipelineId String           @map("pipeline_id")
  version    Int
  status     DemoReportStatus @default(draft)

  // Measured figures, snapshotted at generation. INV-02: every one of these
  // has to trace to the readings that produced it, which is what
  // circuitSnapshot carries — a society disputing this number can be shown
  // the days behind it, not just the result.
  preInstallBaselineTotal Float @map("pre_install_baseline_total")
  postInstallAverageTotal Float @map("post_install_average_total")
  measuredSavingsPct      Float @map("measured_savings_pct")

  // CON-11 extrapolation across the society's full inventory (FEAT-006).
  societyLightCount         Int   @map("society_light_count")
  meteredLightCount         Int   @map("metered_light_count")
  extrapolationFactor       Float @map("extrapolation_factor")
  projectedSavingsKwhPerDay Float @map("projected_savings_kwh_per_day")

  // Per-circuit table: benchmark %, both window averages, and the daily
  // readings behind each window. Json because it is a frozen snapshot, not
  // a queryable working set — the live rows stay in their own tables.
  circuitSnapshot Json @map("circuit_snapshot")

  generatedAt DateTime  @default(now()) @map("generated_at")
  // FEAT-020-AC-6 (added to R0 2026-08-14 — see docs/backlog.yaml's scope
  // note). Draft is never portal-visible; sharing is what makes it so.
  sharedAt    DateTime? @map("shared_at")
  sharedById  String?   @map("shared_by_id")

  pipeline Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  sharedBy AdminUser? @relation("DemoReportSharedBy", fields: [sharedById], references: [id])
  offers   Offer[]

  @@unique([pipelineId, version])
  @@map("demo_reports")
}

// FEAT-024/026 — KYC. Split into a *requirement* (the checklist item, one
// per type per pipeline) and its *files* (the things actually received),
// rather than the architecture sketch's single Document row, because
// FEAT-026-AC-5 requires the same type to arrive twice by different routes
// with one verified and the other retained rather than silently discarded.
// One row per (pipeline, type) cannot express that; this can.
enum KycDocumentType {
  gst_certificate
  electricity_bill

  @@map("kyc_document_type")
}

enum KycRequirementStatus {
  outstanding
  received
  verified
  not_applicable

  @@map("kyc_requirement_status")
}

enum ReceiptChannel {
  portal
  whatsapp
  email
  call
  in_person

  @@map("receipt_channel")
}

enum KycFileState {
  pending
  verified
  rejected

  @@map("kyc_file_state")
}

model KycRequirement {
  id         String               @id @default(cuid())
  pipelineId String               @map("pipeline_id")
  type       KycDocumentType
  status     KycRequirementStatus @default(outstanding)

  // FEAT-024-AC-5 — a type that genuinely doesn't apply (no GST
  // registration) is marked not-applicable *with a reason*, so it stops
  // skewing CON-23's stall signal instead of sitting outstanding forever.
  notApplicableReason String?   @map("not_applicable_reason")
  markedNaById        String?   @map("marked_na_by_id")
  markedNaAt          DateTime? @map("marked_na_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pipeline   Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  markedNaBy AdminUser?        @relation("KycMarkedNaBy", fields: [markedNaById], references: [id])
  files      KycDocumentFile[]
  followUps  KycFollowUp[]

  @@unique([pipelineId, type])
  @@map("kyc_requirements")
}

model KycDocumentFile {
  id             String         @id @default(cuid())
  requirementId  String         @map("requirement_id")
  s3Key          String         @map("s3_key")
  fileName       String         @map("file_name")
  // FEAT-026-AC-1 — how it arrived is part of the record, not incidental.
  receiptChannel ReceiptChannel @map("receipt_channel")
  state          KycFileState   @default(pending)

  rejectionReason String?   @map("rejection_reason")
  verifiedById    String?   @map("verified_by_id")
  verifiedAt      DateTime? @map("verified_at")

  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  requirement KycRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  uploadedBy  AdminUser      @relation("KycFileUploadedBy", fields: [uploadedById], references: [id])
  verifiedBy  AdminUser?     @relation("KycFileVerifiedBy", fields: [verifiedById], references: [id])

  @@index([requirementId])
  @@map("kyc_document_files")
}

// FEAT-024-AC-3 — CON-23's per-step follow-up count. A row per follow-up
// rather than an integer counter, so "how many times did we chase this, and
// when" is answerable; a bare counter would make the lead-health signal
// unauditable.
model KycFollowUp {
  id            String   @id @default(cuid())
  requirementId String   @map("requirement_id")
  note          String
  recordedById  String   @map("recorded_by_id")
  recordedAt    DateTime @default(now()) @map("recorded_at")

  requirement KycRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  recordedBy  AdminUser      @relation("KycFollowUpBy", fields: [recordedById], references: [id])

  @@index([requirementId])
  @@map("kyc_follow_ups")
}

// FEAT-027/028 — the offer. Versioned: FEAT-028-AC-5 requires a counter to
// produce a new version with the previous one still retrievable exactly as
// issued, so an issued offer is never edited in place.
enum OfferStatus {
  draft
  issued
  countered
  accepted
  rejected

  @@map("offer_status")
}

// CON-25's demo-skip path. `measured` comes from a real benchmark;
// `negotiated_fixed` is INV-02's narrowed exception — the savings
// *percentage* is agreement-derived, while consumption is still metered.
enum BenchmarkSource {
  measured
  negotiated_fixed

  @@map("benchmark_source")
}

model Offer {
  id         String      @id @default(cuid())
  pipelineId String      @map("pipeline_id")
  version    Int
  status     OfferStatus @default(draft)

  benchmarkSource BenchmarkSource @map("benchmark_source")
  // Per-circuit benchmark table snapshotted at offer time (CON-11) — the
  // offer must say what it was priced on even if a circuit is rescaled later.
  circuitTerms    Json            @map("circuit_terms")

  // Commercial terms. FEAT-027-AC-3 makes tolerance/revenue-share/term hard
  // requirements to issue, since every downstream billing decision reads them.
  tolerancePct        Float @map("tolerance_pct")
  revenueSharePct     Float @map("revenue_share_pct")
  unitElectricityRate Float @map("unit_electricity_rate")
  termMonths          Int   @map("term_months")
  exclusions          Json?
  amcTerms            Json? @map("amc_terms")
  spareStockCount     Int   @default(0) @map("spare_stock_count")

  // Derived at generation from the demo numbers, shown on the offer.
  projectedMonthlyFee Float? @map("projected_monthly_fee")

  demoReportId String? @map("demo_report_id")

  issuedAt   DateTime? @map("issued_at")
  issuedById String?   @map("issued_by_id")

  // GATE-04 is enforced server-side in the action; this records *who*
  // responded, it does not authorize them.
  respondedAt     DateTime? @map("responded_at")
  respondedById   String?   @map("responded_by_id")
  responseNote    String?   @map("response_note")
  // FEAT-028-AC-5 — the terms the society asked for, on the version their
  // counter produced.
  counteredFromId String?   @unique @map("countered_from_id")

  createdAt DateTime @default(now()) @map("created_at")

  pipeline      Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  demoReport    DemoReport? @relation(fields: [demoReportId], references: [id])
  issuedBy      AdminUser?  @relation("OfferIssuedBy", fields: [issuedById], references: [id])
  respondedBy   Profile?    @relation("OfferRespondedBy", fields: [respondedById], references: [id])
  counteredFrom Offer?      @relation("OfferCounter", fields: [counteredFromId], references: [id])
  counterOf     Offer?      @relation("OfferCounter")
  agreement     Agreement?

  @@unique([pipelineId, version])
  @@map("offers")
}

// FEAT-029 — agreement preparation through execution. AC-2 requires the
// outstanding work to show as discrete steps rather than one opaque status,
// which is why these are four nullable timestamps and not a single enum.
model Agreement {
  id         String @id @default(cuid())
  pipelineId String @unique @map("pipeline_id")
  offerId    String @unique @map("offer_id")

  preparedAt   DateTime  @default(now()) @map("prepared_at")
  preparedById String    @map("prepared_by_id")
  printedAt    DateTime? @map("printed_at")
  notarizedAt  DateTime? @map("notarized_at")
  signedAt     DateTime? @map("signed_at")

  // AC-3's hard gate: without the executed scan the pipeline cannot advance
  // to installation, because installation commits FirsThing's own capital.
  executedS3Key    String?   @map("executed_s3_key")
  executedFileName String?   @map("executed_file_name")
  uploadedAt       DateTime? @map("uploaded_at")
  uploadedById     String?   @map("uploaded_by_id")

  // AC-5 — the physically-signed document is authoritative, but where it
  // differs from the accepted offer that difference must be visible rather
  // than silently reconciled.
  hasDeviation  Boolean @default(false) @map("has_deviation")
  deviationNote String? @map("deviation_note")

  pipeline   Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  offer      Offer      @relation(fields: [offerId], references: [id])
  preparedBy AdminUser  @relation("AgreementPreparedBy", fields: [preparedById], references: [id])
  uploadedBy AdminUser? @relation("AgreementUploadedBy", fields: [uploadedById], references: [id])
  contract   Contract?

  @@map("agreements")
}

// FEAT-062 — the contract record. CON-01a (confirmed 2026-08-13): one
// tolerancePct per contract, applied independently per circuit.
enum ContractStatus {
  draft
  active
  amended
  expired
  terminated

  @@map("contract_status")
}

model Contract {
  id          String         @id @default(cuid())
  pipelineId  String         @unique @map("pipeline_id")
  societyId   String         @map("society_id")
  serviceLine ServiceLine    @map("service_line")
  agreementId String         @unique @map("agreement_id")
  status      ContractStatus @default(draft)

  termStart DateTime @map("term_start")
  termEnd   DateTime @map("term_end")

  activatedAt   DateTime? @map("activated_at")
  activatedById String?   @map("activated_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  pipeline    Pipeline              @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  society     Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  agreement   Agreement             @relation(fields: [agreementId], references: [id])
  activatedBy AdminUser?            @relation("ContractActivatedBy", fields: [activatedById], references: [id])
  versions    ContractTermVersion[]

  @@map("contracts")
}

// FEAT-062-AC-5 — terms are versioned and effective-dated, and an amendment
// applies forward only: prior months stay computed against the version in
// force at the time. Same replay-from-events rule as BenchmarkRescaleEvent
// (ADR-005), for the same reason — a restated invoice is a disputed invoice.
model ContractTermVersion {
  id            String   @id @default(cuid())
  contractId    String   @map("contract_id")
  version       Int
  effectiveFrom DateTime @map("effective_from")

  benchmarkSource     BenchmarkSource @map("benchmark_source")
  tolerancePct        Float           @map("tolerance_pct")
  revenueSharePct     Float           @map("revenue_share_pct")
  unitElectricityRate Float           @map("unit_electricity_rate")
  exclusions          Json?
  amcTerms            Json?           @map("amc_terms")
  spareStockCount     Int             @default(0) @map("spare_stock_count")
  // Per-circuit benchmark table this version bills against (CON-11).
  circuitBenchmarks   Json            @map("circuit_benchmarks")

  recordedById String   @map("recorded_by_id")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  recordedBy AdminUser @relation("ContractTermRecordedBy", fields: [recordedById], references: [id])

  calculations MonthlyCalculation[]

  @@unique([contractId, version])
  @@index([contractId, effectiveFrom])
  @@map("contract_term_versions")
}

// ═══════════════════════════════════════════════════════════════════════
// MS-06 — full installation execution (CAP-21, COMP-01 + COMP-06)
// ═══════════════════════════════════════════════════════════════════════

// ── Field operations (COMP-06) ───────────────────────────────────────────
// CON-44/ADR-007: a field visit is worked by a *team*, not an owner. The
// exposure is double-counting, not corruption — two people counting one
// corridor inflates a light count, which sets the represented count, which
// sets the benchmark, which sets the fee. Built here because MS-06 is the
// first milestone with a real multi-day, multi-area field workload; MS-03's
// survey and MS-04's commissioning both predate it and are untouched.
//
// Installation is the *easy* case for this model on purpose: batches are
// area-scoped at creation (CON-44's own note on SCR-061), so two technicians
// in two towers hold two claims that cannot collide. The contested path is
// still modelled here rather than deferred, because the survey case (which
// genuinely negotiates its partition on site) is the harder client of the
// same tables and shouldn't have to introduce them later.
enum FieldVisitType {
  installation_day

  @@map("field_visit_type")
}

enum FieldVisitState {
  scheduled
  in_progress
  submitted
  cancelled

  @@map("field_visit_state")
}

enum AreaClaimStatus {
  claimed
  // Two offline claims on one area both sync. Neither wins: the area is
  // contested and the person submitting resolves it by hand with a recorded
  // reason. Rows are never summed, deduplicated or silently merged (CON-44).
  contested
  resolved

  @@map("area_claim_status")
}

model FieldVisit {
  id String @id @default(cuid())

  type       FieldVisitType
  // Polymorphic by design (09-architecture.md §5.2 note 2 / RISK-09): one
  // scheduler serves every visit type. No DB-level FK — referential validity
  // is asserted in the test suite instead, per §9's testing convention.
  sourceType String         @map("source_type") // "InstallationProject" today
  sourceId   String         @map("source_id")

  societyId String          @map("society_id")
  state     FieldVisitState @default(scheduled)

  scheduledFor DateTime? @map("scheduled_for")
  proposedAt   DateTime  @default(now()) @map("proposed_at")

  society      Society                 @relation(fields: [societyId], references: [id], onDelete: Cascade)
  participants FieldVisitParticipant[]
  areaClaims   FieldVisitAreaClaim[]
  batches      InstallationBatch[]

  @@index([sourceType, sourceId])
  @@map("field_visits")
}

model FieldVisitParticipant {
  id           String    @id @default(cuid())
  fieldVisitId String    @map("field_visit_id")
  userId       String    @map("user_id")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  acceptedAt   DateTime? @map("accepted_at")

  fieldVisit FieldVisit @relation(fields: [fieldVisitId], references: [id], onDelete: Cascade)
  user       AdminUser  @relation("FieldVisitParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fieldVisitId, userId])
  @@map("field_visit_participants")
}

// Advisory and optimistic, never a lock — CON-44 rules out pessimistic
// locking outright because a lock cannot be acquired offline. Claiming an
// already-claimed area is *permitted*; the @@unique is per claimant, so two
// claims on one area coexist and the area goes contested.
model FieldVisitAreaClaim {
  id           String   @id @default(cuid())
  fieldVisitId String   @map("field_visit_id")
  areaKey      String   @map("area_key")
  claimedById  String   @map("claimed_by_id")
  claimedAt    DateTime @default(now()) @map("claimed_at")

  status          AreaClaimStatus @default(claimed)
  contestedReason String?         @map("contested_reason")
  resolvedById    String?         @map("resolved_by_id")
  resolvedAt      DateTime?       @map("resolved_at")
  resolutionNote  String?         @map("resolution_note")

  fieldVisit FieldVisit @relation(fields: [fieldVisitId], references: [id], onDelete: Cascade)
  claimedBy  AdminUser  @relation("AreaClaimClaimedBy", fields: [claimedById], references: [id])
  resolvedBy AdminUser? @relation("AreaClaimResolvedBy", fields: [resolvedById], references: [id])

  @@unique([fieldVisitId, areaKey, claimedById])
  @@index([fieldVisitId, status])
  @@map("field_visit_area_claims")
}

// ── Installation project (CAP-21) ────────────────────────────────────────
enum InstallationProjectState {
  planning
  published
  complete

  @@map("installation_project_state")
}

model InstallationProject {
  id         String @id @default(cuid())
  pipelineId String @unique @map("pipeline_id")
  societyId  String @map("society_id")

  state InstallationProjectState @default(planning)

  // FEAT-033-AC-5 — where the contracted scope differs from what the survey
  // found (the society excludes a tower, say), the *difference is recorded*.
  // The survey stays a record of what exists; the project records what is
  // contracted. Editing the inventory to match would destroy the only
  // evidence that a scope decision was ever made.
  surveyedLightCount   Int     @map("surveyed_light_count")
  contractedLightCount Int     @map("contracted_light_count")
  scopeVarianceNote    String? @map("scope_variance_note")

  // FEAT-033-AC-3 — CON-21's daily review gate has no meaning without a
  // named reviewer, so a project cannot be published without one. Any of the
  // three portal roles may hold it (SCR-060: "society contact per day,
  // PER-06"); it is *being named*, not holding office-bearer authority, that
  // confers the approval right — which is what makes this distinct from
  // GATE-04's binding acts.
  onlookerId String @map("onlooker_id")

  // FEAT-035-AC-5 / CON-21 — the review gate is skippable once per project
  // only, with explicit backend approval. A hard count, enforced here: these
  // columns being non-null *is* the allowance spent.
  gateSkipUsedAt     DateTime? @map("gate_skip_used_at")
  gateSkipBatchId    String?   @map("gate_skip_batch_id")
  gateSkipApprovedBy String?   @map("gate_skip_approved_by")
  gateSkipReason     String?   @map("gate_skip_reason")

  publishedAt DateTime? @map("published_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  pipeline     Pipeline                 @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  society      Society                  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  onlooker     Profile                  @relation("ProjectOnlooker", fields: [onlookerId], references: [id])
  createdBy    AdminUser                @relation("InstallationProjectCreatedBy", fields: [createdById], references: [id])
  skipApprover AdminUser?               @relation("GateSkipApprovedBy", fields: [gateSkipApprovedBy], references: [id])
  plannedDays  InstallationPlannedDay[]
  batches      InstallationBatch[]
  blockers     InstallationBlocker[]
  certificate  CompletionCertificate?

  @@map("installation_projects")
}

// One planned day × area. SCR-060's plan must reconcile to the survey:
// planned counts across all days equal the contracted scope, or publishing
// is refused — a mismatch is either a survey error or an undocumented scope
// change, and both are cheaper to resolve now than on site.
model InstallationPlannedDay {
  id        String @id @default(cuid())
  projectId String @map("project_id")

  day          Int
  plannedDate  DateTime @map("planned_date")
  // The crew's start time on that date — CON-21's 3-hour deadline is counted
  // back from this, so it is stored rather than assumed.
  startAt      DateTime @map("start_at")
  areaKey      String   @map("area_key")
  plannedCount Int      @map("planned_count")

  assignedToId String? @map("assigned_to_id")
  // Optional per-day override of the project's onlooker (SCR-060 assigns one
  // "per day"); null means the project's named onlooker reviews that day.
  onlookerId   String? @map("onlooker_id")

  project    InstallationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo AdminUser?          @relation("PlannedDayAssignee", fields: [assignedToId], references: [id])
  onlooker   Profile?            @relation("PlannedDayOnlooker", fields: [onlookerId], references: [id])
  batches    InstallationBatch[]

  @@unique([projectId, day, areaKey])
  @@index([projectId, plannedDate])
  @@map("installation_planned_days")
}

enum BatchState {
  draft
  awaiting_review
  approved
  disputed

  @@map("batch_state")
}

model InstallationBatch {
  id           String  @id @default(cuid())
  projectId    String  @map("project_id")
  plannedDayId String? @map("planned_day_id")
  fieldVisitId String? @map("field_visit_id")

  day            Int
  areaKey        String  @map("area_key")
  // Floor, wing, corridor — what a disputing onlooker needs in order to go
  // and check (SCR-061).
  locationDetail String? @map("location_detail")

  installedCount       Int     @default(0) @map("installed_count")
  removedFittingsCount Int     @default(0) @map("removed_fittings_count")
  // FEAT-034-AC-5 — skipped fixtures stay in the project's outstanding scope
  // with a reason. They must not silently reduce it; an inaccessible flat is
  // work still owed, not work that evaporated.
  skippedCount         Int     @default(0) @map("skipped_count")
  skippedReason        String? @map("skipped_reason")

  // FEAT-034-AC-3 — photos are what make the society's review and any
  // dispute resolvable, so a batch cannot be submitted without them.
  photoKeys Json @default("[]") @map("photo_keys")

  state         BatchState @default(draft)
  submittedById String?    @map("submitted_by_id")
  submittedAt   DateTime?  @map("submitted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project     InstallationProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plannedDay  InstallationPlannedDay? @relation(fields: [plannedDayId], references: [id], onDelete: SetNull)
  fieldVisit  FieldVisit?             @relation(fields: [fieldVisitId], references: [id], onDelete: SetNull)
  submittedBy AdminUser?              @relation("BatchSubmittedBy", fields: [submittedById], references: [id])
  review      BatchReview?
  blockers    InstallationBlocker[]

  @@index([projectId, day])
  @@map("installation_batches")
}

enum BatchDecision {
  approved
  disputed

  @@map("batch_decision")
}

model BatchReview {
  id      String @id @default(cuid())
  batchId String @unique @map("batch_id")

  decision          BatchDecision
  // Disputing requires photo + location evidence (FEAT-035, FLOW-07 step 3):
  // a dispute stops work and has to be actionable by someone standing in the
  // building tomorrow. Approving is deliberately one tap — friction there
  // costs a crew a day.
  evidencePhotoKeys Json?         @map("evidence_photo_keys")
  evidenceLocation  String?       @map("evidence_location")
  note              String?

  reviewedById String   @map("reviewed_by_id")
  reviewedAt   DateTime @default(now()) @map("reviewed_at")

  batch      InstallationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reviewedBy Profile           @relation("BatchReviewedBy", fields: [reviewedById], references: [id])

  @@map("batch_reviews")
}

enum BlockerType {
  stock_shortage
  access_denied
  site_condition
  // The one with contractual consequence: more lights than surveyed changes
  // the represented count, which changes extrapolation, which changes every
  // future bill (FEAT-036-AC-5, CON-10).
  count_discrepancy
  equipment_fault

  @@map("blocker_type")
}

enum BlockerStatus {
  open
  resolved
  waived

  @@map("blocker_status")
}

model InstallationBlocker {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  batchId   String? @map("batch_id")

  type      BlockerType
  areaKey   String?     @map("area_key")
  detail    String
  photoKeys Json        @default("[]") @map("photo_keys")

  // The date the blocker affects — a blocker still open past it is
  // schedule-impacting rather than an ordinary open item (FEAT-036-AC-3).
  affectedDate DateTime? @map("affected_date")

  // Count-discrepancy only: the newly-found total. Never applied here —
  // FEAT-036-AC-5 routes it to whoever owns the contract terms (an amendment
  // or the contract's own rescale clause, FEAT-041). There is deliberately
  // no write path from this column to a circuit's represented count.
  discoveredLightCount Int? @map("discovered_light_count")

  status       BlockerStatus @default(open)
  raisedById   String        @map("raised_by_id")
  raisedAt     DateTime      @default(now()) @map("raised_at")
  resolution   String?
  resolvedById String?       @map("resolved_by_id")
  resolvedAt   DateTime?     @map("resolved_at")

  project    InstallationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch      InstallationBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  raisedBy   AdminUser           @relation("BlockerRaisedBy", fields: [raisedById], references: [id])
  resolvedBy AdminUser?          @relation("BlockerResolvedBy", fields: [resolvedById], references: [id])

  @@index([projectId, status])
  @@map("installation_blockers")
}

// FEAT-037 / CON-22 — the signature that ends installation and starts
// billing. signedAt is the *signature* date, not the sync date (SCR-064's
// own open question, specified that way because it favours the society);
// billingStartDate is always the day after, and the first month is prorated
// on the actual remaining days of that calendar month.
model CompletionCertificate {
  id        String @id @default(cuid())
  projectId String @unique @map("project_id")

  signedAt      DateTime @map("signed_at")
  signatoryName String   @map("signatory_name")
  signatoryRole String   @map("signatory_role")
  signatureKey  String?  @map("signature_key")

  totalInstalledCount Int @map("total_installed_count")

  billingStartDate DateTime @map("billing_start_date")
  proratedDays     Int      @map("prorated_days")
  daysInMonth      Int      @map("days_in_month")

  // Any blocker waived to clear the gate (PER-01 only, never field staff) —
  // recorded on the certificate so a waived gate is visible on the document
  // that started billing, not just in a log.
  waivedBlockerIds Json?   @map("waived_blocker_ids")
  waiverReason     String? @map("waiver_reason")

  recordedById String   @map("recorded_by_id")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  project    InstallationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy AdminUser           @relation("CertificateRecordedBy", fields: [recordedById], references: [id])

  @@map("completion_certificates")
}

// ── Reading ingest (COMP-03, MS-07) ───────────────────────────────────────
//
// CON-30's shape, made concrete. The vendor CSV is the *evidence*; the
// readings are an interpretation of it. Both are persisted, and the
// interpretation is replayable — see `src/lib/gemini.ts` for why the model
// only ever proposes a mapping and never transforms the rows itself.

enum ReadingSource {
  csv
  // FEAT-104's scheduled vendor fetch is R1 and nothing writes this value
  // yet. It exists now because §5.2 makes a reading's identity
  // (circuit, date, source) — adding the value later would mean rewriting
  // that unique constraint against live rows.
  api

  @@map("reading_source")
}

enum ReadingUploadStatus {
  pending_normalization // raw file stored, AI unavailable or not yet run — FEAT-043-AC-3
  awaiting_mapping // AI proposed a mapping, or asked a question — FEAT-044
  ready // mapping confirmed and the whole file parsed; nothing committed yet
  committed
  abandoned // FEAT-044-AC-3 — walked away without leaving partial readings
  superseded // replaced by a later upload for the same circuit+period — FEAT-043-AC-5

  @@map("reading_upload_status")
}

enum ReadingAnomalyKind {
  zero_reading
  out_of_range
  day_over_day_jump
  missing_days

  @@map("reading_anomaly_kind")
}

enum ReadingAnomalyStatus {
  open
  accepted // accepted as real consumption, reason recorded
  excluded // the days are excluded from the calculation — never interpolated
  sent_back // returned to the upload queue for a corrected file

  @@map("reading_anomaly_status")
}

model RawReadingFile {
  id        String @id @default(cuid())
  circuitId String @map("circuit_id")

  // INV-04 / CON-25 — always an explicit operator selection at upload time,
  // never inferred from the file's own contents. The parser in fact refuses
  // rows outside this period rather than trusting them.
  //
  // Nullable since the circuit-page commissioning flow (CON-45, 2026-08-17):
  // there the anchor is not a chosen month but the circuit's own recorded
  // dates (meterInstalledAt / lightReplacementDate / last stored reading),
  // and the derived range is stored below and shown to the operator before
  // anything commits. The global monthly-billing path still always sets it.
  period String?

  // CON-45 — the circuit-page flow's derived extraction window, recorded so
  // the provenance chain states exactly which slice of the file was used.
  rangeStart  DateTime?    @map("range_start")
  rangeEnd    DateTime?    @map("range_end")
  ingestPhase IngestPhase? @map("ingest_phase")

  s3Key       String  @map("s3_key")
  fileName    String  @map("file_name")
  contentType String  @map("content_type")
  byteSize    Int     @map("byte_size")
  vendor      String?

  // Which sheet the readings were taken from, when the upload is a workbook.
  // A society's history often arrives as one file covering several circuits
  // (Ace City: Basement and LiftLobby in five sheets), so without this the
  // provenance chain cannot say whose consumption a figure came from.
  sheetName String? @map("sheet_name")

  status ReadingUploadStatus @default(pending_normalization)

  /// Meter-page imports that filed this review (see MeterCsvImport).
  meterCsvImports MeterCsvImport[]

  // The mapping the model proposed, and the one actually used. Both are kept:
  // FEAT-047-AC-1 needs the mapping in the provenance chain, and keeping the
  // proposal beside the confirmed version is what makes FEAT-044-AC-5's
  // override visible after the fact rather than indistinguishable from
  // agreement.
  proposedMapping   Json?   @map("proposed_mapping")
  confirmedMapping  Json?   @map("confirmed_mapping")
  clarifications    Json? // FEAT-044 — the questions asked and the answers given
  aiConfidence      String? @map("ai_confidence")
  aiError           String? @map("ai_error") // FEAT-043-AC-3 — why normalisation could not run
  mappingOverridden Boolean @default(false) @map("mapping_overridden")

  rowsParsed   Int? @map("rows_parsed")
  daysProduced Int? @map("days_produced")

  // FEAT-047-AC-5 — a replaced upload stays in the history with the
  // supersession recorded, so a figure that changed has a visible reason.
  supersededById String?   @unique @map("superseded_by_id")
  supersededAt   DateTime? @map("superseded_at")

  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  circuit      Circuit          @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  uploadedBy   AdminUser        @relation("RawReadingUploadedBy", fields: [uploadedById], references: [id])
  supersededBy RawReadingFile?  @relation("RawFileSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   RawReadingFile?  @relation("RawFileSupersession")
  readings     MeterReading[]
  anomalies    ReadingAnomaly[]

  @@index([circuitId, period])
  @@map("raw_reading_files")
}

model MeterReading {
  id        String        @id @default(cuid())
  circuitId String        @map("circuit_id")
  date      DateTime // the calendar day, at UTC midnight
  kWh       Float         @map("kwh")
  source    ReadingSource

  // Hourly→daily is the system's job (CON-30). Keeping the interval count
  // makes a partial day visible as a partial day rather than as a low
  // reading — 6 hours of data and a genuinely quiet night look identical
  // once they are both a single number.
  intervalCount Int? @map("interval_count")

  validityFlag Boolean @default(true) @map("validity_flag")
  anomalyFlag  Boolean @default(false) @map("anomaly_flag")

  // Excluded days are excluded, never interpolated (FLOW-09 step 7, CON-12).
  excludedAt     DateTime? @map("excluded_at")
  excludedById   String?   @map("excluded_by_id")
  excludedReason String?   @map("excluded_reason")

  // ADR-005 — a value is superseded, never silently overwritten.
  supersededValue    Float?    @map("superseded_value")
  supersededAt       DateTime? @map("superseded_at")
  supersededByUserId String?   @map("superseded_by_user_id")

  // Set once a released MonthlyCalculation has consumed it (MS-08). Blocks
  // any further overwrite outright — INV-03.
  usedInCalculationId String? @map("used_in_calculation_id")

  // What a complete day holds under the file's granularity (24 for hourly).
  // intervalCount below it is a partial day — shown as one, not as a low
  // reading.
  expectedIntervals Int? @map("expected_intervals")

  rawFileId String @map("raw_file_id")

  circuit Circuit        @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  rawFile RawReadingFile @relation(fields: [rawFileId], references: [id], onDelete: Cascade)

  // §5.2 — interval-level identity. Two sources may each hold a value for
  // the same day; that is a conflict to report (FEAT-107, R1), not a
  // constraint violation.
  @@unique([circuitId, date, source])
  @@index([circuitId, date])
  @@map("meter_readings")
}

model ReadingAnomaly {
  id        String    @id @default(cuid())
  circuitId String    @map("circuit_id")
  period    String
  // Null for a period-scoped finding (missing days); a specific day otherwise.
  date      DateTime?

  kind   ReadingAnomalyKind
  detail String // the specific reason, in words, not a code

  observedValue Float? @map("observed_value")
  expectedValue Float? @map("expected_value")
  deviationPct  Float? @map("deviation_pct")

  // INV-09 / FEAT-048-AC-3 — an open anomaly holds the month out of billing.
  blocksBilling Boolean              @default(true) @map("blocks_billing")
  status        ReadingAnomalyStatus @default(open)

  resolutionReason String?   @map("resolution_reason")
  resolvedById     String?   @map("resolved_by_id")
  resolvedAt       DateTime? @map("resolved_at")

  rawFileId String? @map("raw_file_id")

  detectedAt DateTime @default(now()) @map("detected_at")

  circuit    Circuit         @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  rawFile    RawReadingFile? @relation(fields: [rawFileId], references: [id], onDelete: SetNull)
  resolvedBy AdminUser?      @relation("ReadingAnomalyResolvedBy", fields: [resolvedById], references: [id])

  @@index([circuitId, period])
  @@index([status])
  @@map("reading_anomalies")
}

// CON-12's floor is 20 days. Below it the system will not compute a
// billing-grade comparison unprompted — but PER-01 can accept the month
// explicitly, and that acceptance is a recorded act with an owner, not a
// flag someone flipped. One row per circuit-month is the point: accepting
// twice is the same acceptance.
model CoverageAcceptance {
  id        String @id @default(cuid())
  circuitId String @map("circuit_id")
  period    String

  coverageDays Int @map("coverage_days")
  daysInMonth  Int @map("days_in_month")

  reason       String
  acceptedById String   @map("accepted_by_id")
  acceptedAt   DateTime @default(now()) @map("accepted_at")

  circuit    Circuit   @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  acceptedBy AdminUser @relation("CoverageAcceptedBy", fields: [acceptedById], references: [id])

  @@unique([circuitId, period])
  @@map("coverage_acceptances")
}

// ═══════════════════════════════════════════════════════════════════════
// MS-08 — calculation, compliance, release & delivery (CAP-04/05/06/13)
// ═══════════════════════════════════════════════════════════════════════

// FEAT-048-AC-3 / INV-09 — a month whose readings still carry unresolved
// blocking anomalies is `held`, not calculated. `sent_back` is FEAT-054's
// other outcome: the accountant returns it to ops with a note rather than
// releasing it. A released month is terminal and immutable (GATE-02) — a
// correction is a new version, never an edit.
enum CalculationStatus {
  held
  calculated
  released
  sent_back
  superseded

  @@map("calculation_status")
}

enum ComplianceResult {
  in_band
  out_of_band

  @@map("compliance_result")
}

// CON-01c / OQ-10 — the adjustment is a basis flip, not a separate penalty
// formula. `actual_metered` bills through CON-11 using the month's own
// measured savings % in place of the benchmark.
enum PricingBasis {
  fixed
  actual_metered

  @@map("pricing_basis")
}

// CON-01b's named exclusion list, plus the one cause that is FirsThing's own.
// Only `firsthing_attributable` can ever move a bill; every other value
// leaves it at the contracted amount however long the shortfall runs. The
// list is an enum rather than free text precisely so that rule is checkable.
enum DeviationRootCause {
  firsthing_attributable
  lighting_layout_change
  blocked_sensors
  usage_pattern_change
  external_electrical
  society_maintenance

  @@map("deviation_root_cause")
}

// CON-31's chain: ops → inspector → ops → management. Deliberately not a
// two-outcome fixable/not-fixable flag — "not resolvable" is an escalation
// to a different decision-maker, not an ops conclusion.
enum DeviationReviewState {
  raised
  assigned
  investigated
  decided
  closed
  escalated

  @@map("deviation_review_state")
}

// CON-13's invoice-linked state machine. `warning` covers the 5-day
// countdown whether or not an extension has been granted — an extension
// moves the deadline and is recorded as its own row, rather than becoming a
// status that would hide whether the countdown is still running. (This is a
// deliberate narrowing of 09-architecture.md §5.2's sketched `extended`
// status; §5.2 is representative, not exhaustive.)
enum BillingInvoiceStatus {
  attached
  released
  overdue
  warning
  suspended
  paid

  @@map("billing_invoice_status")
}

// FEAT-053-AC-3 — a mismatch between the app's computed amount and the Zoho
// invoice's actual amount is surfaced and must be acknowledged, never
// auto-reconciled.
enum ReconciliationStatus {
  unchecked
  matched
  mismatched
  acknowledged

  @@map("reconciliation_status")
}

// FEAT-048 — one row per (society, service line, period, version).
//
// INV-02 lives on `inputVersionSnapshot`: every figure below has to trace to
// the readings, benchmark and contract-term version that produced it, months
// later, without re-deriving them from tables that have since moved on.
// FEAT-048-AC-4 is why a re-run creates a NEW version and supersedes the old
// one rather than updating in place — "corrections happen by fixing inputs
// and re-running, which is itself recorded."
model MonthlyCalculation {
  id          String      @id @default(cuid())
  societyId   String      @map("society_id")
  serviceLine ServiceLine @map("service_line")
  period      String // YYYY-MM — the operator's own selection upstream (INV-04)
  version     Int         @default(1)

  status     CalculationStatus @default(held)
  heldReason String?           @map("held_reason")

  // Totals. Unrounded on purpose; rounding happens once, at presentation.
  totalExtrapolatedKwh Float @map("total_extrapolated_kwh")
  totalSavedKwh        Float @map("total_saved_kwh")
  totalSavedValue      Float @map("total_saved_value")
  subtotal             Float
  total                Float

  // CON-22 — set only on a first or final partial month.
  proratedDays Int? @map("prorated_days")
  daysInMonth  Int? @map("days_in_month")

  // Coverage carried through to every derived figure (FEAT-048-AC-5) — a
  // 24/30-day month is never presented as a full one.
  coverageDays   Int @map("coverage_days")
  coverageOfDays Int @map("coverage_of_days")

  // GATE-01. The readings, benchmarks and contract version this used.
  inputVersionSnapshot Json @map("input_version_snapshot")

  contractTermVersionId String? @map("contract_term_version_id")

  calculatedAt DateTime  @default(now()) @map("calculated_at")
  releasedAt   DateTime? @map("released_at")
  releasedById String?   @map("released_by_id")

  sentBackAt   DateTime? @map("sent_back_at")
  sentBackById String?   @map("sent_back_by_id")
  sentBackNote String?   @map("sent_back_note")

  supersededById String?   @unique @map("superseded_by_id")
  supersededAt   DateTime? @map("superseded_at")

  society             Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  contractTermVersion ContractTermVersion? @relation(fields: [contractTermVersionId], references: [id])
  releasedBy          AdminUser?           @relation("CalculationReleasedBy", fields: [releasedById], references: [id])
  sentBackBy          AdminUser?           @relation("CalculationSentBackBy", fields: [sentBackById], references: [id])
  supersededBy        MonthlyCalculation?  @relation("CalculationSupersession", fields: [supersededById], references: [id])
  supersedes          MonthlyCalculation?  @relation("CalculationSupersession")

  feeLines      CircuitFeeLine[]
  savingsReport SavingsReport?
  invoice       BillingInvoice?

  @@unique([societyId, serviceLine, period, version])
  @@index([status, period])
  @@map("monthly_calculations")
}

// ADR-004 / CON-11 — the per-circuit billing grain. An invoice is a set of
// these summing to a total, never a single society-level figure, and one
// line can flip to `actual_metered` while its siblings stay fixed.
model CircuitFeeLine {
  id                   String @id @default(cuid())
  monthlyCalculationId String @map("monthly_calculation_id")
  circuitId            String @map("circuit_id")

  meteredKwh              Float @map("metered_kwh")
  meteredLightCount       Int   @map("metered_light_count")
  representedLightCount   Int   @map("represented_light_count")
  extrapolatedConsumption Float @map("extrapolated_consumption")

  baselineKwhPerDay   Float @map("baseline_kwh_per_day")
  benchmarkSavingsPct Float @map("benchmark_savings_pct")
  measuredSavingsPct  Float @map("measured_savings_pct")
  deviationPct        Float @map("deviation_pct")

  complianceResult ComplianceResult @map("compliance_result")
  // CON-01d — in band but within 20% of its edge. GOAL-08's early warning.
  approaching      Boolean          @default(false)

  pricingBasis           PricingBasis @default(fixed) @map("pricing_basis")
  // CON-01c's streak state, per circuit. Survives a recalculation.
  consecutiveBreachCount Int          @default(0) @map("consecutive_breach_count")

  savedKwh   Float @map("saved_kwh")
  savedValue Float @map("saved_value")
  amount     Float

  coverageDays Int @map("coverage_days")

  calculation     MonthlyCalculation @relation(fields: [monthlyCalculationId], references: [id], onDelete: Cascade)
  circuit         Circuit            @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  deviationReview DeviationReview?

  @@unique([monthlyCalculationId, circuitId])
  @@index([circuitId])
  @@map("circuit_fee_lines")
}

// FEAT-055 / CON-31 — raised per circuit, never per society, so a broken
// light type cannot hide inside three healthy ones.
//
// INV-03 is the reason `rootCause` and `ownerId` are both required before a
// review can be decided: a revenue-affecting judgment call needs an owner
// and a classification, not a fixable/not-fixable flag.
model DeviationReview {
  id               String @id @default(cuid())
  circuitFeeLineId String @unique @map("circuit_fee_line_id")

  state DeviationReviewState @default(raised)

  // Set at step 4, from what the inspector reported (CON-31).
  rootCause         DeviationRootCause? @map("root_cause")
  decision          String?
  // CON-01b's "corrected within a month at no cost" path — a corrected
  // attributable shortfall does NOT adjust the bill (FEAT-050-AC-5).
  correctedAtNoCost Boolean             @default(false) @map("corrected_at_no_cost")

  // FEAT-050-AC-3 — an excluded cause still bills in full, but the society
  // is told why. Silence reads as an unexplained bad month.
  societyExplanation String? @map("society_explanation")

  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at")
  findings     String?

  ownerId String? @map("owner_id")

  escalatedAt    DateTime? @map("escalated_at")
  escalationNote String?   @map("escalation_note")

  raisedAt  DateTime  @default(now()) @map("raised_at")
  decidedAt DateTime? @map("decided_at")
  closedAt  DateTime? @map("closed_at")

  feeLine    CircuitFeeLine @relation(fields: [circuitFeeLineId], references: [id], onDelete: Cascade)
  assignedTo AdminUser?     @relation("DeviationAssignedTo", fields: [assignedToId], references: [id])
  owner      AdminUser?     @relation("DeviationOwner", fields: [ownerId], references: [id])

  @@index([state])
  @@map("deviation_reviews")
}

// FEAT-059 / CON-33 — distinct from the invoice, and the one of the pair
// this app actually generates. Figures are not editable (AC-4); the
// narrative is, which is the same locked-figures/editable-presentation split
// FEAT-021's demo report already established.
model SavingsReport {
  id                   String @id @default(cuid())
  monthlyCalculationId String @unique @map("monthly_calculation_id")

  narrative  String?
  // INV-02 — the readings, benchmark version and contract terms behind
  // every figure on the report.
  provenance Json

  generatedAt DateTime @default(now()) @map("generated_at")

  calculation MonthlyCalculation @relation(fields: [monthlyCalculationId], references: [id], onDelete: Cascade)

  @@map("savings_reports")
}

// FEAT-053 / CON-33 — the tax invoice is generated in Zoho and uploaded
// here, never generated by this app. Named `BillingInvoice` rather than
// `Invoice` to keep it unambiguous against the archived app's own `Invoice`
// table, which was a different thing entirely.
model BillingInvoice {
  id                   String @id @default(cuid())
  monthlyCalculationId String @unique @map("monthly_calculation_id")

  number    String
  issueDate DateTime @map("issue_date")
  dueDate   DateTime @map("due_date")
  amount    Float

  s3Key        String @map("s3_key")
  fileName     String @map("file_name")
  uploadedById String @map("uploaded_by_id")

  // FEAT-053-AC-1/AC-3 — the app's computed total vs what Zoho actually
  // invoiced. A mismatch blocks release until acknowledged.
  reconciliationStatus     ReconciliationStatus @default(unchecked) @map("reconciliation_status")
  computedAmount           Float                @map("computed_amount")
  mismatchAcknowledgedById String?              @map("mismatch_acknowledged_by_id")
  mismatchAcknowledgedNote String?              @map("mismatch_acknowledged_note")

  status BillingInvoiceStatus @default(attached)

  // CON-13's safety rule. Deliberately SEPARATE from the payments themselves:
  // a society that has never paid anything has no `Payment` row to date-stamp,
  // yet "we have no record of payment" still might mean "nobody has checked
  // since Tuesday". What must be same-day fresh before a suspension fires is
  // the *confirmation against Zoho*, which is this field. Without it the rule
  // could not distinguish "confirmed unpaid today" from "never looked".
  paymentStatusConfirmedAt   DateTime? @map("payment_status_confirmed_at")
  paymentStatusConfirmedById String?   @map("payment_status_confirmed_by_id")

  // CON-13's clock. Set on RELEASE, not on generation — release is the event
  // downstream keys off (FLOW-10 step 10).
  releasedAt        DateTime? @map("released_at")
  overdueTrackingAt DateTime? @map("overdue_tracking_at")
  warningStartedAt  DateTime? @map("warning_started_at")
  suspendDueAt      DateTime? @map("suspend_due_at")
  suspendedAt       DateTime? @map("suspended_at")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  calculation              MonthlyCalculation @relation(fields: [monthlyCalculationId], references: [id], onDelete: Cascade)
  uploadedBy               AdminUser          @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id])
  mismatchAcknowledgedBy   AdminUser?         @relation("InvoiceMismatchAckBy", fields: [mismatchAcknowledgedById], references: [id])
  paymentStatusConfirmedBy AdminUser?         @relation("InvoicePaymentConfirmedBy", fields: [paymentStatusConfirmedById], references: [id])

  payments   Payment[]
  extensions InvoiceExtension[]

  @@index([status, suspendDueAt])
  @@map("billing_invoices")
}

// CON-13 — payments are recorded manually by ops from Zoho, and
// `confirmedAsOf` is the freshness stamp the suspension job reads. A
// suspension may only fire against a same-day-confirmed status: stale data
// stops the clock rather than firing on it. This field is the whole safety
// rule, which is why it is explicit rather than inferred from `recordedAt`.
model Payment {
  id        String @id @default(cuid())
  invoiceId String @map("invoice_id")

  amount        Float
  confirmedAsOf DateTime @map("confirmed_as_of")
  reference     String?

  recordedById String   @map("recorded_by_id")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  invoice    BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy AdminUser      @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// CON-13 — granted in increments of up to 5 days per request. Rows rather
// than a single mutable deadline so "up to ~10 days total across requests"
// is auditable rather than inferred from a moved date.
model InvoiceExtension {
  id        String @id @default(cuid())
  invoiceId String @map("invoice_id")

  days   Int
  reason String

  grantedById String   @map("granted_by_id")
  grantedAt   DateTime @default(now()) @map("granted_at")

  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  grantedBy AdminUser      @relation("ExtensionGrantedBy", fields: [grantedById], references: [id])

  @@index([invoiceId])
  @@map("invoice_extensions")
}

// ─── CON-45 — circuit load inventory & the SONOFF reading-review flow ──────
// (user-specified 2026-08-17: the circuit knows what hangs off it, the
// theoretical daily figure is computed from that, and every uploaded reading
// is reviewed row by row against it before anything is saved)

// Which phase of a circuit's life a raw file was ingested for. Derived from
// the circuit's own recorded dates at upload time, never asked of the
// operator — but stored, because provenance should say what the system
// decided, not make a later reader re-derive it.
enum IngestPhase {
  pre_install
  post_install
  monitoring

  @@map("ingest_phase")
}

enum DeviceRole {
  // What a survey finds on a circuit — tube light, fan, TV.
  original
  // What FirsThing installs — motion-enabled batten, dimmable surface light.
  replacement

  @@map("device_role")
}

// The predefined catalog the dropdowns read from. Ops-maintained; adding a
// manufacturer's new fixture is a row here, not a code change.
model DeviceType {
  id             String     @id @default(cuid())
  name           String     @unique
  role           DeviceRole
  defaultWattage Float?     @map("default_wattage")
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at")

  /// A surveyor on site meets fixtures the catalog does not have, so one can
  /// be added from the survey itself (the user's call, 2026-08-26) — but it
  /// arrives PROPOSED, not usable. Its wattage feeds the theoretical figure
  /// a baseline is judged against and therefore a benchmark a society is
  /// billed on, so a figure nobody but the person who typed it has seen must
  /// not reach that. Approval is operations'.
  status          DeviceTypeStatus @default(approved)
  proposedById    String?          @map("proposed_by_id")
  proposedNote    String?          @map("proposed_note")
  approvedById    String?          @map("approved_by_id")
  approvedAt      DateTime?        @map("approved_at")
  rejectionReason String?          @map("rejection_reason")
  /// Approving makes it usable on the circuit that proposed it; listing it
  /// is a second, separate decision — a one-off fixture in one basement is
  /// not necessarily something every surveyor should be offered.
  inCatalog       Boolean          @default(true) @map("in_catalog")

  // Soft delete. A device type is referenced by every CircuitDevice line
  // recorded against it — a load inventory that produced a theoretical
  // figure a baseline was judged against. Removing the row would either fail
  // on those references or leave inventory lines pointing at nothing, so
  // removal only hides it from the pickers.
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  // 1-5 compatible replacements per original type — the installer picking a
  // replacement only ever sees this mapped list, never the whole catalog.
  replacementOptions DeviceReplacementOption[] @relation("OriginalType")
  replacementFor     DeviceReplacementOption[] @relation("ReplacementType")

  deletedBy  AdminUser? @relation("DeviceTypeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  proposedBy AdminUser? @relation("DeviceTypeProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  approvedBy AdminUser? @relation("DeviceTypeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  circuitDevices      CircuitDevice[] @relation("CircuitDeviceType")
  circuitReplacements CircuitDevice[] @relation("CircuitReplacementType")

  @@map("device_types")
}

model DeviceReplacementOption {
  id                String @id @default(cuid())
  originalTypeId    String @map("original_type_id")
  replacementTypeId String @map("replacement_type_id")

  original    DeviceType @relation("OriginalType", fields: [originalTypeId], references: [id], onDelete: Cascade)
  replacement DeviceType @relation("ReplacementType", fields: [replacementTypeId], references: [id], onDelete: Cascade)

  @@unique([originalTypeId, replacementTypeId])
  @@map("device_replacement_options")
}

// One line item of the circuit's load inventory: "20 × 20W tube light, 24h".
// Σ(count × wattage × hoursPerDay) ÷ 1000 is the theoretical daily kWh every
// pre-install reading is compared against — the check that nothing unknown
// is silently consuming on a circuit surveyed as lighting-only.
model CircuitDevice {
  id           String @id @default(cuid())
  circuitId    String @map("circuit_id")
  deviceTypeId String @map("device_type_id")

  count       Int
  wattage     Float // per-unit watts — editable per line; the catalog only supplies a default
  hoursPerDay Float   @map("hours_per_day") // 24 or 12 normally; custom allowed (user's call 2026-08-17)
  note        String?

  /// This line is on the circuit but NOT part of the retrofit — the meter
  /// sees it before and after, so its theoretical consumption is subtracted
  /// from BOTH sides before a savings percentage is taken (the user's call,
  /// 2026-08-26; replaces CON-16's "no non-installation appliances share
  /// this circuit", which would have disqualified circuits that are in fact
  /// live and billing — Gaur Saundaryam's five unreplaced surface lights are
  /// exactly this case, and its own report deducts them by hand).
  ///
  /// It is NOT subtracted from the theoretical figure a pre-install READING
  /// is validated against: the meter measures the whole circuit, so CON-17's
  /// load check has to compare against the whole circuit too.
  excludedFromCalculation Boolean @default(false) @map("excluded_from_calculation")

  // Stage-3 installation recording — what was actually installed against this
  // line, chosen from the compatibility mapping. Null until the engineer
  // records it; replacedAt on every line is what completes the installation.
  replacementTypeId  String?   @map("replacement_type_id")
  replacementCount   Int?      @map("replacement_count")
  replacementWattage Float?    @map("replacement_wattage")
  replacedAt         DateTime? @map("replaced_at")
  replacedById       String?   @map("replaced_by_id")

  // Backfill provenance. The inventory normally freezes at light replacement,
  // because it is the record the replacement was judged against. A circuit
  // that was commissioned BEFORE this system existed has no such record to
  // protect — it has to be entered after the fact — so those lines are
  // allowed through the freeze and carry this flag saying so. A figure
  // reconstructed from paper is not the same evidence as one captured on
  // site, and INV-02 means the difference has to be visible, not assumed.
  historical     Boolean @default(false)
  historicalNote String? @map("historical_note")
  recordedById   String? @map("recorded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  circuit         Circuit     @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  deviceType      DeviceType  @relation("CircuitDeviceType", fields: [deviceTypeId], references: [id])
  replacementType DeviceType? @relation("CircuitReplacementType", fields: [replacementTypeId], references: [id])
  replacedBy      AdminUser?  @relation("CircuitDeviceReplacedBy", fields: [replacedById], references: [id])
  recordedBy      AdminUser?  @relation("CircuitDeviceRecordedBy", fields: [recordedById], references: [id])

  @@index([circuitId])
  @@map("circuit_devices")
}

// ── CAP — water tank monitoring (user-specified 2026-08-25) ────────────────
//
// Tank level sensors live in the company's Smart Life (Tuya) account; the
// platform mirrors that account read-only and maps each sensor to the
// society it serves. Monitor-only throughout — INV-08 applies to pump
// relays exactly as it does to pump hardware: status is read, never
// commanded.

/// The one Tuya cloud project the sensors live in. A singleton row, editable
/// only by operations. The secret is write-only from the UI: it is stored
/// here and used server-side, but no action ever returns it to the browser.
model TankApiConfig {
  id              String    @id @default("singleton")
  baseUrl         String    @default("https://openapi.tuyain.com") @map("base_url")
  accessId        String    @map("access_id")
  accessSecret    String    @map("access_secret")
  updatedById     String?   @map("updated_by_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// The last successful token + device-list round trip, and what it saw.
  lastOkAt        DateTime? @map("last_ok_at")
  lastError       String?   @map("last_error")
  lastDeviceCount Int?      @map("last_device_count")
  lastSyncAt      DateTime? @map("last_sync_at")

  updatedBy AdminUser? @relation("TankApiConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("tank_api_config")
}

/// A device mirrored from the Smart Life account. Every device is mirrored —
/// including ones with no water-level signal — so nothing in the account is
/// invisible from the product; only level-bearing devices can be assigned.
model WaterTank {
  id               String    @id @default(cuid())
  tuyaDeviceId     String    @unique @map("tuya_device_id")
  name             String
  productName      String    @map("product_name")
  category         String
  hasLevelSignal   Boolean   @default(false) @map("has_level_signal")
  /// The declared MAXIMUM of this device's level datapoint, from its thing
  /// model. It is not always 100: the IT56WLCW controllers on this account
  /// declare `liquid_level_percent` as 0-60, so a raw 45 is 75% full — which
  /// is what the Smart Life app shows and what we showed as 45% until this
  /// was found (2026-08-25). Every stored level is normalised through it.
  levelMax         Int       @default(100) @map("level_max")
  /// Which supply this tank serves — Domestic / Flush / STP — so the portal
  /// can group tanks the way a resident thinks about them. Null until the
  /// back office classifies it; the portal states that rather than guessing.
  setupType        TankSetup? @map("setup_type")
  /// The assignment that scopes portal visibility (INV-05): a society's
  /// portal accounts see exactly the tanks whose societyId is theirs.
  societyId        String?   @map("society_id")
  assignedAt       DateTime? @map("assigned_at")
  assignedById     String?   @map("assigned_by_id")
  /// Cache of the sensor's last known state, refreshed by the sampling job
  /// and opportunistically by live page loads.
  lastLevelPercent Int?      @map("last_level_percent")
  lastOnline       Boolean   @default(false) @map("last_online")
  lastReportedAt   DateTime? @map("last_reported_at")
  syncedAt         DateTime  @default(now()) @map("synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  society    Society?           @relation(fields: [societyId], references: [id], onDelete: SetNull)
  assignedBy AdminUser?         @relation("WaterTankAssignedBy", fields: [assignedById], references: [id])
  readings   TankLevelReading[]

  @@index([societyId])
  @@map("water_tanks")
}

/// One sample per tank per run of the half-hourly job — the store the
/// history chart and portal sparklines read, so stats survive the sensor
/// going offline (and survive the Smart Life account itself).
model TankLevelReading {
  id           String    @id @default(cuid())
  tankId       String    @map("tank_id")
  recordedAt   DateTime  @map("recorded_at")
  levelPercent Int       @map("level_percent")
  online       Boolean
  /// When the sensor itself last reported at sample time — an offline
  /// sensor's level is its last report, and the row says so.
  reportedAt   DateTime? @map("reported_at")

  tank WaterTank @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId, recordedAt])
  @@map("tank_level_readings")
}

// ---- eWeLink (SONOFF) meter mirror -------------------------------------
// See docs/engineering/14-meter-ingest-ewelink.md. Unlike Tuya's static
// key pair, eWeLink is OAuth2: a human authorises the account once and the
// backend refreshes from then on, so the tokens and their expiries are part
// of the configuration rather than derived on demand.
model EwelinkApiConfig {
  id     String @id @default("singleton")
  /// as | us | eu | cn — CoolKit's regional hosts. India is served by Asia.
  region String @default("as")

  appId       String @map("app_id")
  appSecret   String @map("app_secret")
  /// Must match a redirect URL registered against the application, so every
  /// environment (local, stage, production) registers its own.
  redirectUrl String @map("redirect_url")

  /// Access token 30 days, refresh token 60 days (CoolKit's own lifetimes).
  /// Stored rather than re-minted because only a human can start the flow.
  accessToken           String?   @map("access_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshToken          String?   @map("refresh_token")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  /// Which eWeLink account was authorised, so a surprise device list has a
  /// visible cause.
  accountLabel          String?   @map("account_label")

  lastOkAt        DateTime? @map("last_ok_at")
  lastError       String?   @map("last_error")
  lastDeviceCount Int?      @map("last_device_count")
  lastSyncAt      DateTime? @map("last_sync_at")

  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy AdminUser? @relation("EwelinkApiConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("ewelink_api_config")
}

/// Every device in the authorised eWeLink account, mirrored. Non-metering
/// devices stay listed and unassignable — a device that is simply absent
/// from the screen reads as an account problem rather than as the wrong
/// kind of device.
model MeterDevice {
  id              String @id @default(cuid())
  ewelinkDeviceId String @unique @map("ewelink_device_id")
  name            String
  productModel    String @map("product_model")
  /// CoolKit's device-type id. It decides which energy protocol the device
  /// speaks, and the public protocol document only covers 5 and 32.
  uiid            Int

  online          Boolean @default(false)
  /// Whether this device reports any energy datapoint at all, decided from
  /// the params it actually returned rather than from its model name.
  hasEnergySignal Boolean @default(false) @map("has_energy_signal")
  /// The param keys the device really returned, so the model's protocol is
  /// a recorded observation rather than an assumption (see the design doc).
  observedParams  Json?   @map("observed_params")

  /// The assignment. CON-11 makes the circuit the billing grain, so that is
  /// what a meter is bound to; societyId is carried alongside for scoping
  /// and may be set on its own while the circuit is still undecided.
  societyId    String?   @map("society_id")
  circuitId    String?   @unique @map("circuit_id")
  assignedAt   DateTime? @map("assigned_at")
  assignedById String?   @map("assigned_by_id")

  /// The last known live reading, at its true scale (see ewelink-scale.ts).
  /// Only the LAST value is kept: the hourly series comes from the device's
  /// own exported CSV, not from sampling the API once an hour.
  lastPowerW     Float?    @map("last_power_w")
  lastVoltageV   Float?    @map("last_voltage_v")
  lastCurrentA   Float?    @map("last_current_a")
  /// The device's own counter for the calendar day, at the last read.
  lastDayKwh     Float?    @map("last_day_kwh")
  /// The device's own counter for the calendar month, at the last read.
  lastMonthKwh   Float?    @map("last_month_kwh")
  /// When the last successful read happened, so a screen showing the values
  /// above can say how old they are instead of implying they are live.
  lastReadAt     DateTime? @map("last_read_at")
  lastReportedAt DateTime? @map("last_reported_at")
  /// When the hourly poll last actually reached this device.
  lastSampleAt   DateTime? @map("last_sample_at")
  /// Set the moment a poll finds the meter unreachable, cleared the moment
  /// it reports again — so "how long has this been down" is a stored fact
  /// rather than something inferred from a gap in the samples.
  offlineSince   DateTime? @map("offline_since")
  /// Consecutive failed or unreachable polls. An alert is raised on the
  /// second, not the first: one missed hour is a flaky connection, two in a
  /// row is a meter somebody has to go and look at.
  consecutiveFailures Int   @default(0) @map("consecutive_failures")
  /// Who gets chased when this meter stops reporting. Work in this codebase
  /// has a named owner (the survey assignee, the installation onlooker);
  /// an alert addressed to nobody is an alert nobody acts on.
  ownerId        String?   @map("owner_id")
  syncedAt       DateTime  @default(now()) @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  society    Society?      @relation(fields: [societyId], references: [id], onDelete: SetNull)
  circuit    Circuit?      @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  assignedBy AdminUser?    @relation("MeterDeviceAssignedBy", fields: [assignedById], references: [id])
  owner      AdminUser?    @relation("MeterDeviceOwner", fields: [ownerId], references: [id])
  samples    MeterSample[]
  alerts     MeterAlert[]
  hourly     MeterHourlyReading[]
  csvImports MeterCsvImport[]

  @@index([societyId])
  @@map("meter_devices")
}

/// One row per hourly poll of an assigned meter: what it read and whether it
/// answered. This is TELEMETRY, deliberately separate from MeterReading —
/// the store a bill is computed from. A sample is a live observation; a
/// MeterReading is evidence a society is billed on, and CON-45 requires the
/// second to be reviewed before it is stored. Conflating them would put an
/// unreviewed figure into a billed total, which is what INV-02 and INV-09
/// exist to prevent.
model MeterSample {
  id         String    @id @default(cuid())
  meterId    String    @map("meter_id")
  recordedAt DateTime  @map("recorded_at")
  online     Boolean
  powerW     Float?    @map("power_w")
  voltageV   Float?    @map("voltage_v")
  currentA   Float?    @map("current_a")
  /// The device's own day and month counters at sample time.
  dayKwh     Float?    @map("day_kwh")
  monthKwh   Float?    @map("month_kwh")
  /// When the device itself last reported, at sample time. Connected is not
  /// the same as reporting — the distinction the water-tank work had to
  /// learn the hard way.
  reportedAt DateTime? @map("reported_at")

  meter MeterDevice @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@index([meterId, recordedAt])
  @@map("meter_samples")
}

/// What raised an alert against a meter.
enum MeterAlertKind {
  /// Two consecutive polls could not reach it, or it reported itself down.
  offline
  /// Its day's consumption sits outside what the circuit can physically draw.
  out_of_range
  /// CON-01a — measured savings have fallen below the agreed benchmark by
  /// more than the contract's own tolerance. A COMMERCIAL condition, unlike
  /// the two above: nothing is broken, the circuit is under-delivering.
  savings_out_of_band
}

/// A meter needing somebody's attention, kept open until it is resolved.
///
/// One OPEN alert per meter per kind — a partial unique index enforces it,
/// not application discipline. An hourly job that files a fresh row every
/// hour produces a notification list nobody reads, and then the one that
/// matters goes down with the rest. The alert stays open while the condition
/// holds, and closes with a stated reason.
model MeterAlert {
  id String @id @default(cuid())

  /// What the alert is about. A hardware condition names the METER; a
  /// commercial one (savings out of band) names the CIRCUIT, which may have
  /// readings from an upload and no meter bound at all. Exactly one is set.
  meterId   String? @map("meter_id")
  circuitId String? @map("circuit_id")

  kind     MeterAlertKind
  openedAt DateTime       @default(now()) @map("opened_at")
  /// The line a person is chased with — it names the meter, what it
  /// measures and how long it has been out.
  message  String
  /// The observation that opened it, kept so the decision can be judged
  /// later rather than only the conclusion.
  detail   Json?

  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id")

  /// An acknowledged alert whose condition has NOT gone away comes back to
  /// the badge after a cool-off, and this counts how often. One row per
  /// ongoing condition, not one per reminder: a continuing problem is one
  /// problem, and duplicating it would make the history unreadable.
  reraisedAt DateTime? @map("reraised_at")
  raiseCount Int       @default(1) @map("raise_count")

  closedAt     DateTime? @map("closed_at")
  closedReason String?   @map("closed_reason")

  meter          MeterDevice? @relation(fields: [meterId], references: [id], onDelete: Cascade)
  circuit        Circuit?     @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  acknowledgedBy AdminUser?  @relation("MeterAlertAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([meterId, openedAt])
  @@index([circuitId, openedAt])
  @@index([closedAt])
  @@map("meter_alerts")
}

/// One hour of a meter's consumption, as exported from the device itself.
///
/// This is the hourly series, and it comes from the CSV a person downloads
/// from the meter — NOT from the live API. The device holds a month of
/// hourly slots internally (its `getHoursKwh` descriptor spans 744), but no
/// public REST endpoint returns their contents, and polling the API once an
/// hour would only ever produce a counter reading, never the hour itself.
///
/// The day and hour are stored exactly as the export prints them (a local
/// calendar date at UTC midnight, plus the hour index 0-23), so nothing is
/// converted on the way in. A half-hour timezone offset is precisely the
/// kind of conversion that silently moves a reading into the wrong day.
///
/// Deliberately NOT a MeterReading: that is the store a bill is computed
/// from, and CON-45 requires those to be reviewed row by row before they are
/// stored. This is the monitoring series.
model MeterHourlyReading {
  id      String   @id @default(cuid())
  meterId String   @map("meter_id")
  /// The local calendar day the export printed, at UTC midnight.
  day     DateTime
  /// 0-23, the hour the export printed (`10:00-11:00` is hour 10).
  hour    Int
  kWh     Float    @map("kwh")

  importId  String?  @map("import_id")
  createdAt DateTime @default(now()) @map("created_at")

  meter  MeterDevice     @relation(fields: [meterId], references: [id], onDelete: Cascade)
  import MeterCsvImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([meterId, day, hour])
  @@index([meterId, day])
  @@map("meter_hourly_readings")
}

/// A meter export somebody uploaded: which file, which meter, and how the
/// two were matched.
///
/// The export carries no device identity at all — only `data,time,
/// consumption/KWh` — so which meter it belongs to is a JUDGEMENT, and one
/// worth recording. The system proposes a meter by overlapping its existing
/// hours against the file's, and a person confirms it. Storing the evidence
/// means a file filed against the wrong meter can be found later rather than
/// only suspected.
model MeterCsvImport {
  id       String @id @default(cuid())
  meterId  String @map("meter_id")
  fileName String @map("file_name")
  /// The S3 key of the file as uploaded, kept for the same reason CON-30
  /// keeps raw reading files: the figures have to trace to the bytes.
  s3Key    String? @map("s3_key")
  /// The billing-review hand-off: when the meter was bound to a circuit at
  /// import time, the same file was filed into CON-45's review queue, and
  /// this is that record. Null means there was no circuit to hand off to.
  /// The two stores stay deliberately separate — hourly telemetry here,
  /// reviewed daily figures there — but they share ONE upload and this link
  /// is what makes them one pipeline rather than two tools.
  rawReadingFileId String? @map("raw_reading_file_id")

  /// The range the file covers, as printed in it.
  firstDay DateTime @map("first_day")
  lastDay  DateTime @map("last_day")
  hoursInFile  Int  @map("hours_in_file")
  hoursStored  Int  @map("hours_stored")
  /// Hours already held with a DIFFERENT value, which the import replaced.
  hoursSuperseded Int @default(0) @map("hours_superseded")

  /// How the meter was arrived at, and on what evidence.
  matchMethod   String  @map("match_method")
  matchedHours  Int?    @map("matched_hours")
  matchDetail   Json?   @map("match_detail")
  /// True when the person filed it against a meter the evidence did not
  /// propose. A deliberate override is a fact worth keeping, not a warning
  /// that vanishes once the dialog closes.
  overrodeMatch Boolean @default(false) @map("overrode_match")

  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  meter          MeterDevice          @relation(fields: [meterId], references: [id], onDelete: Cascade)
  uploadedBy     AdminUser            @relation("MeterCsvImportUploadedBy", fields: [uploadedById], references: [id])
  rawReadingFile RawReadingFile?      @relation(fields: [rawReadingFileId], references: [id], onDelete: SetNull)
  readings       MeterHourlyReading[]

  @@index([meterId, uploadedAt])
  @@map("meter_csv_imports")
}

/// A document that belongs to a society but has no workflow of its own —
/// the pre/post demo reports, savings reports, gate passes and inspection
/// reports that predate this system, plus anything filed for the record.
///
/// Deliberately NOT a shadow copy of documents that DO have a workflow: a
/// KYC file is a KycDocumentFile and a meter export is a RawReadingFile,
/// because those carry state this table has no way to represent. Two rows
/// for one document would drift, which is exactly why the archived app's
/// unified "Documents" listing was built as a live query across the real
/// tables rather than as its own table (2026-08-06).
/// How a resident thinks about a tank: what it supplies.
enum TankSetup {
  domestic
  flush
  stp

  @@map("tank_setup")
}

enum TicketType {
  complaint
  /// A FirsThing fitting or sensor that needs swapping out.
  device_replacement
  /// Removed or spare material waiting to be collected.
  pickup

  @@map("ticket_type")
}

enum TicketStatus {
  open
  in_progress
  resolved

  @@map("ticket_status")
}

/// A society's complaint / replacement / pickup request (customer portal,
/// 2026-08-29). Raised and tracked by portal members holding tickets_manage;
/// deliberately audit-light for v1 — status transitions stamp who and when on
/// the row and log through src/lib/logger.ts, without a per-event table.
model Ticket {
  id             String       @id @default(cuid())
  societyId      String       @map("society_id")
  type           TicketType
  status         TicketStatus @default(open)
  subject        String
  detail         String
  raisedById     String       @map("raised_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  resolvedAt     DateTime?    @map("resolved_at")
  /// Required when resolving — a closed ticket with no stated outcome is
  /// indistinguishable from one closed to tidy a list.
  resolutionNote String?      @map("resolution_note")
  lastStatusById String?      @map("last_status_by_id")
  /// Set when FirsThing staff moved the status — a separate column from
  /// lastStatusById because admin logins live in their own table (INV-01),
  /// so one FK cannot point at both.
  lastStatusByAdminId String?  @map("last_status_by_admin_id")

  society           Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  raisedBy          Profile    @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  lastStatusBy      Profile?   @relation("TicketStatusBy", fields: [lastStatusById], references: [id])
  lastStatusByAdmin AdminUser? @relation("TicketStatusByAdmin", fields: [lastStatusByAdminId], references: [id])

  @@index([societyId, status])
  @@map("tickets")
}

model StoredDocument {
  id        String @id @default(cuid())
  /// The catalog id from src/lib/document-catalog.ts.
  docType   String @map("doc_type")
  societyId String @map("society_id")
  /// INV-04 — always an explicit selection, never inferred from the file.
  ///
  /// This is a FILING SLOT, not a claim about what the document covers: it
  /// keys the version history with (society, docType, version) and names the
  /// folder the file lives in. A demo's two phases can be months apart and a
  /// single phase can straddle a month end (28 Jul – 3 Aug), so what the
  /// document actually covers is recorded below instead of being implied by
  /// one month (the user's question, 2026-08-26).
  period    String

  /// The span the document itself states, read from it and shown beside the
  /// filing slot. Null until it has been read, or when it names no period.
  coversFrom DateTime? @map("covers_from")
  coversTo   DateTime? @map("covers_to")

  /// ADR-005's rule applied to documents (the user's call, 2026-08-26:
  /// "versioning is first priority"). A re-upload into the same slot — same
  /// society, same type, same period — is a NEW VERSION; the previous one
  /// stays exactly as it was filed. Nothing here is ever overwritten.
  version       Int    @default(1)
  /// SHA-256 of what actually landed in S3, hashed server-side from the
  /// stored object rather than trusted from the browser. It is what makes
  /// "different from the one already there" a fact rather than a guess: an
  /// identical re-upload is refused instead of filed as a second version.
  contentSha256 String @map("content_sha256")

  s3Key       String  @map("s3_key")
  fileName    String  @map("file_name")
  contentType String  @map("content_type")
  byteSize    Int     @map("byte_size")
  note        String?

  /// Removing a version is a soft delete, always. The S3 object cannot be
  /// deleted by this app's own credentials (PutObject-only by design), so a
  /// hard delete would claim the file was gone while it sat in the bucket —
  /// and a version filed and then withdrawn is itself a fact worth keeping.
  /// Same shape as circuit and rescale-event voiding.
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  society    Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  uploadedBy AdminUser           @relation("StoredDocumentUploadedBy", fields: [uploadedById], references: [id])
  voidedBy   AdminUser?          @relation("StoredDocumentVoidedBy", fields: [voidedById], references: [id])
  extraction DocumentExtraction?

  /// A version number is used once per slot — the structural guarantee that
  /// two concurrent uploads cannot both become "version 3".
  @@unique([societyId, docType, period, version])
  @@index([societyId, docType])
  @@map("stored_documents")
}

enum ExtractionStatus {
  pending
  proposed
  confirmed
  failed

  @@map("extraction_status")
}

/// The figures read out of a historical report by the model, and the ones a
/// person actually confirmed.
///
/// Both are kept, deliberately: keeping the proposal beside the confirmed
/// version is what makes an operator's correction visible after the fact
/// rather than indistinguishable from agreement — the same reason
/// RawReadingFile keeps proposedMapping alongside confirmedMapping.
///
/// A confirmed figure here is "what this document says", tied to the scan it
/// was read from. It is NOT merged into MeterReading: that store's grain is a
/// day traceable to a raw file, which a monthly printed total cannot satisfy,
/// and INV-02 would have nothing to trace.
model DocumentExtraction {
  id         String           @id @default(cuid())
  documentId String           @unique @map("document_id")
  status     ExtractionStatus @default(pending)

  proposed   Json?
  confirmed  Json?
  modelError String? @map("model_error")

  extractedAt   DateTime? @map("extracted_at")
  confirmedAt   DateTime? @map("confirmed_at")
  confirmedById String?   @map("confirmed_by_id")

  document    StoredDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  confirmedBy AdminUser?     @relation("DocumentExtractionConfirmedBy", fields: [confirmedById], references: [id])

  @@map("document_extractions")
}

enum DeviceTypeStatus {
  /// Added from a survey; its wattage is not yet trusted anywhere.
  proposed
  approved
  rejected

  @@map("device_type_status")
}
